#N canvas 40 60 1280 760 12;
#X declare -path ..;
#X obj 0 0 cnv 1 1280 46 empty empty example\ \ \ ring\ oscillator\ drone\ \ -\ \ three\ neurons\ chasing\ each\ other 14 23 0 20 #1d3557 #ffffff 0;
#X obj 1110 730 declare -path ..;
#X text 800 730 finds the nn.* objects one folder up ->, f 42;
#X text 20 730 neuralplay - Moisés Horta Valenzuela / SEMILLA.AI Studio, f 70;
#X text 20 56 Three leaky neurons in a ring \, each one silencing the next: they can never agree \, so they oscillate. Slow time constants give three interlocked LFOs \, fast ones a buzzing three-phase tone. Here they play a drone. Built from [nn.neuron~] with the tau message (lesson 09)., f 175;
#X obj 10 96 cnv 1 680 560 empty empty THE\ RING 8 12 0 13 #e3f0fb #1d3557 0;
#N canvas 40 60 1000 520 three-neuron-ring 0;
#X obj 10 10 nn.neuron~ sigmoid exring;
#X obj 170 10 nn.neuron~ sigmoid exring;
#X obj 330 10 nn.neuron~ sigmoid exring;
#X text 20 110 A RING OF THREE: every neuron INHIBITS the next one (weight -16 \, bias +8) \, the third inhibits the first. With an odd number of "inverters" the ring can never settle - exactly like the ring oscillator built from three logic inverters in electronics. [block~ 1]: the feedback through [s~]/[r~] is delayed by only one sample., f 130;
#X obj 20 210 block~ 1;
#X obj 20 250 r~ \$0-r0;
#X obj 140 250 r~ \$0-r1;
#X obj 260 250 r~ \$0-r2;
#X obj 20 300 s~ \$0-r0;
#X obj 20 340 outlet~;
#X obj 140 300 s~ \$0-r1;
#X obj 140 340 outlet~;
#X obj 260 300 s~ \$0-r2;
#X obj 260 340 outlet~;
#X obj 420 250 noise~;
#X obj 420 276 *~ 0.01;
#X text 500 250 <- a whisper of noise into the first neuron. Three identical neurons that start equal stay perfectly balanced forever - real oscillators also start from noise., f 40;
#X connect 7 0 0 0;
#X connect 0 0 8 0;
#X connect 0 0 9 0;
#X connect 5 0 1 0;
#X connect 1 0 10 0;
#X connect 1 0 11 0;
#X connect 6 0 2 0;
#X connect 2 0 12 0;
#X connect 2 0 13 0;
#X connect 14 0 15 0;
#X connect 15 0 0 1;
#X coords 0 -1 1 1 490 80 2 5 5;
#X restore 30 130 pd three-neuron-ring;
#X text 530 130 <- open the box: the ring and [block~ 1], f 20;
#X obj 140 228 s~ \$0-n0;
#X obj 30 262 nn.scope~ 4800;
#X obj 365 228 s~ \$0-n1;
#X obj 255 262 nn.scope~ 4800;
#X obj 590 228 s~ \$0-n2;
#X obj 480 262 nn.scope~ 4800;
#X obj 30 380 loadbang;
#X msg 30 406 \; nn-exring w -16 \; nn-exring bias 8;
#X text 230 406 <- every neuron: weight -16 from the previous one \, bias 8 (sent at load). Strong inhibition = a full on/off swing., f 40;
#X obj 30 500 hsl 200 15 0.08 1000 1 1 empty exring-tau tau\ (ms):\ slow\ LFOs\ <->\ buzzing\ tone 0 -8 0 11 #fcfcfc #000000 #000000 15900 1;
#X floatatom 238 499 7 0 0 0 - - - 0;
#X msg 30 526 \; nn-exring tau \$1;
#X text 30 580 TRY: sweep tau slowly from 1000 ms (three slow glides taking turns) down to 0.1 ms (a buzzing tone). Weaker inhibition (w -6 \, bias 3): the swing shrinks \, below about -4 the ring stops., f 85;
#X obj 700 96 cnv 1 570 560 empty empty THE\ DRONE 8 12 0 13 #fff1e0 #1d3557 0;
#N canvas 40 60 1100 520 drone-voices 0;
#X text 20 10 Each neuron output (0..1 \, from [r~ \$0-n0] ... [r~ \$0-n2]) sets the pitch of one sine voice (a fifth apart) and \, centred \, is also heard directly. At slow tau you hear three pitches gliding in turn \, at fast tau a rich buzz., f 140;
#X obj 20 400 outlet~;
#X obj 20 370 *~ 0.12;
#X obj 20 60 r~ \$0-n0;
#X obj 20 90 expr~ 45 + 12 * \$v1;
#X obj 20 116 mtof~;
#X obj 20 142 osc~;
