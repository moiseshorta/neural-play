#X obj 932 970 outlet~;
#X obj 1084 860 expr~ tanh(cfg\$0[96] * \$v1 + cfg\$0[97] * \$v2 + cfg\$0[98] * \$v3 + cfg\$0[99] * \$v4 + cfg\$0[107]), f 19;
