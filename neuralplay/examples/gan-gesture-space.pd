#X text 600 90 <- the current value of each lane \, whoever moves it (you or the playback), f 40;
#X text 20 160 RECORD: mode 1 \, frame 0 \, the play toggle shows off \, then a [metro 125] writes one frame per tick, f 80;
#X obj 20 196 r \$0-record;
#X obj 20 222 t b b b;
