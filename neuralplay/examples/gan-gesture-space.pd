#N canvas 40 60 1100 660 random-preset 0;
#X text 20 10 A RANDOM PRESET from the seed (LeCun normal initialisation): every weight and bias of a layer = spread * gauss / sqrt(fan_in) \, fan_in = how many inputs that layer has (8 \, 4 \, 4 \, 2 \, 4). [random] with a seed always gives the same numbers \, so a seed IS a preset. Gaussian numbers by Box-Muller from two uniform ones., f 148;
#X obj 20 80 r \$0-seed;
#X obj 20 106 t b f;
#X obj 140 132 v seed_\$0;
#X msg 260 132 seed \$1;
#X obj 640 80 r \$0-next;
#X obj 640 106 v seed_\$0;
#X obj 640 132 + 1;
#X obj 640 158 s exvg-seed;
#X text 740 106 <- "new random net": the next seed \, through the seed box, f 30;
#X obj 640 200 r \$0-spread;
#X obj 640 226 v spread_\$0;
#X text 740 200 <- spread from its slider, f 30;
#X obj 20 170 t b b b;
#X text 80 170 1) 216 uniform numbers 0 .. 999999 into uni\$0 \, two per parameter, f 64;
#X msg 80 210 216;
#X msg 127 210 0;
#X obj 80 236 until;
#X obj 80 262 f;
#X obj 120 262 + 1;
#X obj 80 290 t b f;
#X obj 180 320 random 1000000;
#X obj 80 354 tabwrite uni\$0;
#X text 310 320 <- seeded above, f 16;
#X obj 20 390 t b b b;
#X text 80 390 2) parameter i = spread * gauss / sqrt(fan_in of its layer) -> the target preset \, the synth glides there, f 64;
#X msg 80 430 108;
#X msg 127 430 0;
#X obj 80 456 until;
#X obj 80 482 f;
#X obj 120 482 + 1;
#X obj 80 510 expr tgt\$0[\$f1] = spread_\$0 * sqrt(-2 * log((uni\$0[2 * \$f1] + 1) / 1000001)) * cos(6.283185 * uni\$0[2 * \$f1 + 1] / 1000000) / sqrt(if(\$f1 < 36 \, 8 \, if(\$f1 < 56 \, 4 \, if(\$f1 < 68 \, 2 \, 4)))), f 64;
