#X obj 1200 236 v gmode_\$0;
#X text 1200 270 ^ the play toggle: 2 = play \, 0 = by hand (it cannot stop a recording), f 30;
#X text 760 330 PLAYBACK: every 25 ms \, when gmode = 2: move the playhead (pos in frames \, 0 .. 32) \, interpolate the 4 lanes \, back to natural units \, send them to the synth and move the sliders ("set" = no output), f 90;
#X obj 760 390 loadbang;
#X obj 760 416 metro 25;
#X obj 760 442 expr gmode_\$0 == 2;
#X obj 760 468 sel 1;
