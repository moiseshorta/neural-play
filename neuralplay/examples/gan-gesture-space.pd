#N canvas 40 60 1280 1600 12;
#X declare -path ..;
#X obj 0 0 cnv 1 1280 46 empty empty example\ \ \ GAN\ gesture\ space\ \ -\ \ gestures\ you\ record\,\ learned\ by\ a\ GAN\,\ played\ on\ FM\ +\ grains 14 23 0 20 #1d3557 #ffffff 0;
#X obj 1110 1570 declare -path ..;
#X text 800 1570 finds the nn.* objects one folder up ->, f 42;
#X text 20 1570 neuralplay - Moisés Horta Valenzuela / SEMILLA.AI Studio, f 70;
#X text 20 56 Record gestures - 4 seconds of moving the FM controls - and keep each one with a setting of 4 granular clouds. A GAN learns them \, and its latent space becomes a map of gestures you can walk through: modulations in time between and beyond yours., f 175;
#X obj 10 96 cnv 1 390 1010 empty empty THE\ IDEA 8 12 0 13 #eef1f5 #1d3557 0;
#X text 20 122 ONE INSTRUMENT \, THREE ARCHITECTURES. A network shaped like a VAE makes sound at audio rate in a feedback loop with 8 FM voices. 4 granular clouds read a sound of yours. You record GESTURES - 4 seconds of moving the FM controls - and keep each with a setting of the clouds. A GAN learns them and gives you a 2-D map of gestures to walk through., f 52;
#X text 20 248 1 THE VAE (Kingma and Welling 2013) \, untrained - its 108 weights are the sound \, drawn from a seed:, f 52;
#X text 30 299 h = tanh(We x + be) \, x = feedback * voices, f 52;
#X text 30 320 mu = Wm h + bm \, log s^2 = Wv h + bv, f 52;
#X text 30 341 z = mu + tau * s * eps \, eps ~ N(0 \, 1), f 52;
#X text 30 362 out = tanh(W2 tanh(W1 z + b1) + b2), f 52;
#X text 20 383 8 FM VOICES (Chowning 1973) on the harmonics k of f0 \, the index from the network:, f 52;
#X text 30 419 y_k = cos(2 pi k f0 t + I_k cos(2 pi r k f0 t)), f 52;
#X text 30 455 I_k = Imax (out_k + 1) / 2, f 52;
#X text 20 476 lines at k f0 +- n r k f0 with amplitudes J_n(I_k). The voices feed back into the network 64 samples later., f 52;
#X text 20 527 4 GRAIN CLOUDS (Gabor 1947 \, Xenakis \, Roads): a grain is a short window of the sound, f 52;
#X text 30 563 w(t) = 0.5 - 0.5 cos(2 pi t / size), f 52;
#X text 30 584 read at the speed 2^(pitch / 12) \,, f 52;
#X text 20 605 a cloud fires them at its density from its position +- spray., f 52;
#X text 20 641 2 A GESTURE = 4 lanes (FM index \, ratio \, feedback \, noise tau) x 32 frames of 125 ms \, plus the 24 cloud numbers: 152 numbers \, each stored between -1 and 1 (centred). Your gestures are samples from a distribution only you know., f 52;
#X text 20 722 3 THE GAN (Goodfellow et al. 2014). The generator mixes your gestures:, f 52;
#X text 30 758 w = softmax(A2 tanh(A1 z + a1) + a2), f 52;
#X text 30 779 G(z) = w1 g1 + w2 g2 + ..., f 52;
#X text 20 800 The critic D(g) = sigmoid(B2 . lrelu(B1 g + b1) + b2) reads all 152 numbers. In turns the critic lowers -log D(real) - log(1 - D(fake)) and the generator lowers -log D(fake) \, both with Adam (Kingma and Ba 2014) \, plus a little instance noise., f 52;
#X text 20 896 WHY MIX? From a handful of examples a free generator learns a blurry average (we measured it). Mixing keeps every output one of your gestures or a blend \, and the critic decides which blends sound like you. Storing every number between -1 and 1 also mattered: the critic then found 4.4 of 6 demo gestures instead of 3 (measured)., f 52;
#X obj 10 1116 cnv 1 390 444 empty empty TRY\ THIS 8 12 0 13 #e6f6e9 #1d3557 0;
#X text 20 1142 1) Load the demo \, raise the volume \, play gesture 1 .. 6: the FM controls and the 4 clouds move together., f 52;
#X text 20 1193 2) Your own: press record and move the 4 FM sliders for 4 seconds - the gesture loops. Shape the clouds \, then keep it. Collect 4 to 8 of them., f 52;
#X text 20 1259 3) Open a sound of your own for the clouds (or sample the FM synth itself)., f 52;
#X text 20 1295 4) Train. Then walk the map: inside a colour you hear that gesture \, on the borders the GAN's blends - new gestures. Raise T to blend more \, or wander., f 52;
#X text 20 1361 5) Keep a blend you like and train again - curating with a GAN., f 52;
#X obj 410 96 cnv 1 430 386 empty empty 1\ \ THE\ VAE\ FEEDBACK\ SYNTH 8 12 0 13 #e3f0fb #1d3557 0;
#N canvas 40 60 1480 1010 the-vae-network 0;
#X text 20 10 THE VAE AT AUDIO RATE: every neuron is one [expr~] that reads its weights straight out of the preset array cfg\$0 (108 numbers). Layout of a preset: encoder W (4 x 8 \, row by row) at 0 and b at 32 \, mean W (2 x 4) at 36 and b at 44 \, log-variance W (2 x 4) at 46 and b at 54 \, decoder W (4 x 2) at 56 and b at 64 \, output W (8 x 4) at 68 and b at 100 to 107 (all 108 numbers). Loading a preset = writing numbers into cfg\$0 \, no re-wiring. The rows are explained on the right., f 200;
#X obj 20 94 r~ \$0-v0;
#X obj 135 94 r~ \$0-v1;
#X obj 250 94 r~ \$0-v2;
#X obj 365 94 r~ \$0-v3;
#X obj 480 94 r~ \$0-v4;
#X obj 595 94 r~ \$0-v5;
#X obj 710 94 r~ \$0-v6;
#X obj 825 94 r~ \$0-v7;
#X obj 960 94 r \$0-fb;
#X msg 960 120 \$1 50;
#X obj 960 146 line~;
#X text 1040 94 <- feedback amount (smoothed), f 16;
#X text 1270 94 INPUTS x: the 8 FM voices \, one block (64 samples) ago - the feedback, f 28;
#X obj 20 210 expr~ tanh(\$v9 * (cfg\$0[0] * \$v1 + cfg\$0[1] * \$v2 + cfg\$0[2] * \$v3 + cfg\$0[3] * \$v4 + cfg\$0[4] * \$v5 + cfg\$0[5] * \$v6 + cfg\$0[6] * \$v7 + cfg\$0[7] * \$v8) + cfg\$0[32]), f 38;
#X obj 320 210 expr~ tanh(\$v9 * (cfg\$0[8] * \$v1 + cfg\$0[9] * \$v2 + cfg\$0[10] * \$v3 + cfg\$0[11] * \$v4 + cfg\$0[12] * \$v5 + cfg\$0[13] * \$v6 + cfg\$0[14] * \$v7 + cfg\$0[15] * \$v8) + cfg\$0[33]), f 38;
#X obj 620 210 expr~ tanh(\$v9 * (cfg\$0[16] * \$v1 + cfg\$0[17] * \$v2 + cfg\$0[18] * \$v3 + cfg\$0[19] * \$v4 + cfg\$0[20] * \$v5 + cfg\$0[21] * \$v6 + cfg\$0[22] * \$v7 + cfg\$0[23] * \$v8) + cfg\$0[34]), f 38;
#X obj 920 210 expr~ tanh(\$v9 * (cfg\$0[24] * \$v1 + cfg\$0[25] * \$v2 + cfg\$0[26] * \$v3 + cfg\$0[27] * \$v4 + cfg\$0[28] * \$v5 + cfg\$0[29] * \$v6 + cfg\$0[30] * \$v7 + cfg\$0[31] * \$v8) + cfg\$0[35]), f 38;
#X text 1270 210 ENCODER: h_j = tanh( fb * sum_i We[j \, i] x_i + be_j ) \, 4 tanh neurons, f 28;
#X obj 20 344 expr~ cfg\$0[36] * \$v1 + cfg\$0[37] * \$v2 + cfg\$0[38] * \$v3 + cfg\$0[39] * \$v4 + cfg\$0[44], f 30;
#X obj 320 344 expr~ cfg\$0[46] * \$v1 + cfg\$0[47] * \$v2 + cfg\$0[48] * \$v3 + cfg\$0[49] * \$v4 + cfg\$0[54], f 30;
#X obj 620 344 expr~ cfg\$0[40] * \$v1 + cfg\$0[41] * \$v2 + cfg\$0[42] * \$v3 + cfg\$0[43] * \$v4 + cfg\$0[45], f 30;
#X obj 920 344 expr~ cfg\$0[50] * \$v1 + cfg\$0[51] * \$v2 + cfg\$0[52] * \$v3 + cfg\$0[53] * \$v4 + cfg\$0[55], f 30;
#X text 1270 344 THE LATENT POINT \, linear: mean mu_m = sum_j Wm[m \, j] h_j + bm_m and log-variance log s^2_m = sum_j Wv[m \, j] h_j + bv_m (boxes: mu 1 \, log s^2 1 \, mu 2 \, log s^2 2), f 28;
#X obj 560 450 r \$0-tau;
#X msg 560 476 \$1 50;
#X obj 560 502 line~;
#X text 620 502 <- tau, f 8;
#X obj 1000 450 noise~;
#X obj 1080 450 noise~;
#X obj 1000 476 expr~ sqrt(-2 * log(max(0.5 - 0.5 * \$v1 \, 1e-12))) * cos(3.14159265 * (\$v2 + 1)) \; sqrt(-2 * log(max(0.5 - 0.5 * \$v1 \, 1e-12))) * sin(3.14159265 * (\$v2 + 1)), f 34;
#X text 1270 450 eps \, Box-Muller (on the left): two uniform noises -> two independent Gaussian ones \, mean 0 and variance 1, f 28;
#X obj 20 660 expr~ \$v1 + \$v4 * exp(0.5 * \$v2) * \$v3, f 40;
#X obj 620 660 expr~ \$v1 + \$v4 * exp(0.5 * \$v2) * \$v3, f 40;
#X obj 100 700 s~ \$0-z0;
#X text 1270 600 SAMPLING \, the reparameterisation trick (Kingma and Welling 2013): z_m = mu_m + tau * exp(log s^2_m / 2) * eps_m \, fresh eps every sample. tau = 0: a plain autoencoder \, tau = 1: a real VAE sample. z1 also goes to the scope ([s~ \$0-z0]), f 28;
#X obj 20 790 expr~ tanh(cfg\$0[56] * \$v1 + cfg\$0[57] * \$v2 + cfg\$0[64]), f 40;
#X obj 320 790 expr~ tanh(cfg\$0[58] * \$v1 + cfg\$0[59] * \$v2 + cfg\$0[65]), f 40;
#X obj 620 790 expr~ tanh(cfg\$0[60] * \$v1 + cfg\$0[61] * \$v2 + cfg\$0[66]), f 40;
#X obj 920 790 expr~ tanh(cfg\$0[62] * \$v1 + cfg\$0[63] * \$v2 + cfg\$0[67]), f 40;
#X text 1270 790 DECODER: g_n = tanh( W1[n \, 1] z_1 + W1[n \, 2] z_2 + b1_n ) \, 4 tanh neurons, f 28;
#X obj 20 860 expr~ tanh(cfg\$0[68] * \$v1 + cfg\$0[69] * \$v2 + cfg\$0[70] * \$v3 + cfg\$0[71] * \$v4 + cfg\$0[100]), f 19;
#X obj 20 970 outlet~;
#X obj 172 860 expr~ tanh(cfg\$0[72] * \$v1 + cfg\$0[73] * \$v2 + cfg\$0[74] * \$v3 + cfg\$0[75] * \$v4 + cfg\$0[101]), f 19;
#X obj 172 970 outlet~;
#X obj 324 860 expr~ tanh(cfg\$0[76] * \$v1 + cfg\$0[77] * \$v2 + cfg\$0[78] * \$v3 + cfg\$0[79] * \$v4 + cfg\$0[102]), f 19;
#X obj 324 970 outlet~;
#X obj 476 860 expr~ tanh(cfg\$0[80] * \$v1 + cfg\$0[81] * \$v2 + cfg\$0[82] * \$v3 + cfg\$0[83] * \$v4 + cfg\$0[103]), f 19;
#X obj 476 970 outlet~;
#X obj 628 860 expr~ tanh(cfg\$0[84] * \$v1 + cfg\$0[85] * \$v2 + cfg\$0[86] * \$v3 + cfg\$0[87] * \$v4 + cfg\$0[104]), f 19;
#X obj 628 970 outlet~;
#X obj 780 860 expr~ tanh(cfg\$0[88] * \$v1 + cfg\$0[89] * \$v2 + cfg\$0[90] * \$v3 + cfg\$0[91] * \$v4 + cfg\$0[105]), f 19;
#X obj 780 970 outlet~;
#X obj 932 860 expr~ tanh(cfg\$0[92] * \$v1 + cfg\$0[93] * \$v2 + cfg\$0[94] * \$v3 + cfg\$0[95] * \$v4 + cfg\$0[106]), f 19;
#X obj 932 970 outlet~;
#X obj 1084 860 expr~ tanh(cfg\$0[96] * \$v1 + cfg\$0[97] * \$v2 + cfg\$0[98] * \$v3 + cfg\$0[99] * \$v4 + cfg\$0[107]), f 19;
#X obj 1084 970 outlet~;
#X text 1270 880 OUTPUTS: out_k = tanh( sum_n W2[k \, n] g_n + b2_k ) \, 8 tanh neurons \, one per FM voice: its modulation index, f 28;
