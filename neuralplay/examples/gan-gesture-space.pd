#X obj 80 430 expr cur\$0[0 + rf_\$0] = 2 * imax_\$0 / 8 - 1 \; cur\$0[32 + rf_\$0] = 2 * log(ratio_\$0 / 0.25) / log(16) - 1 \; cur\$0[64 + rf_\$0] = 2 * fb_\$0 / 2 - 1 \; cur\$0[96 + rf_\$0] = 2 * tau_\$0 / 1.5 - 1, f 90;
