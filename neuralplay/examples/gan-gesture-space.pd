#X obj 1160 546 v pos_\$0;
#X obj 800 580 expr 8 * (cur\$0[0 + int(pos_\$0)] + (cur\$0[0 + (int(pos_\$0) + 1) % 32] - cur\$0[0 + int(pos_\$0)]) * (pos_\$0 - int(pos_\$0)) + 1) / 2 \; 0.25 * pow(16 \, (cur\$0[32 + int(pos_\$0)] + (cur\$0[32 + (int(pos_\$0) + 1) % 32] - cur\$0[32 + int(pos_\$0)]) * (pos_\$0 - int(pos_\$0)) + 1) / 2) \; 2 * (cur\$0[64 + int(pos_\$0)] + (cur\$0[64 + (int(pos_\$0) + 1) % 32] - cur\$0[64 + int(pos_\$0)]) * (pos_\$0 - int(pos_\$0)) + 1) / 2 \; 1.5 * (cur\$0[96 + int(pos_\$0)] + (cur\$0[96 + (int(pos_\$0) + 1) % 32] - cur\$0[96 + int(pos_\$0)]) * (pos_\$0 - int(pos_\$0)) + 1) / 2, f 90;
