#X obj 80 436 expr smp\$0[\$f1] = 0.22 * (((\$f1 / 48000) > 0) * exp(-2.5 * ((\$f1 / 48000) - 0)) * sin(6.283185 * 220 * ((\$f1 / 48000) - 0) + 3 * exp(-2.5 * ((\$f1 / 48000) - 0)) * sin(6.283185 * 308 * ((\$f1 / 48000) - 0))) + ((\$f1 / 48000) > 1) * exp(-2.5 * ((\$f1 / 48000) - 1)) * sin(6.283185 * 329.63 * ((\$f1 / 48000) - 1) + 3 * exp(-2.5 * ((\$f1 / 48000) - 1)) * sin(6.283185 * 461.482 * ((\$f1 / 48000) - 1))) + ((\$f1 / 48000) > 2) * exp(-2.5 * ((\$f1 / 48000) - 2)) * sin(6.283185 * 277.18 * ((\$f1 / 48000) - 2) + 3 * exp(-2.5 * ((\$f1 / 48000) - 2)) * sin(6.283185 * 388.052 * ((\$f1 / 48000) - 2))) + ((\$f1 / 48000) > 3) * exp(-2.5 * ((\$f1 / 48000) - 3)) * sin(6.283185 * 440 * ((\$f1 / 48000) - 3) + 3 * exp(-2.5 * ((\$f1 / 48000) - 3)) * sin(6.283185 * 616 * ((\$f1 / 48000) - 3)))), f 100;
