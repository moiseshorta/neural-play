#N canvas 40 60 1100 820 12;
#X obj 0 0 cnv 1 1100 46 empty empty nn.neuron~\ \ -\ \ one\ artificial\ neuron\ at\ audio\ rate 14 23 0 20 #1d3557 #ffffff 0;
#X text 20 56 y = f( w1 x1 + w2 x2 + w3 x3 + w4 x4 + w5 x5 + b ). Five signal inputs \, five weights (green sliders) \, a bias (purple) and an activation curve. Everything can be dragged with the mouse or set with messages. Optional leak (tau) turns it into a continuous-time neuron with memory., f 150;
#X obj 10 116 cnv 1 640 490 empty empty TRY\ IT:\ a\ neuron\ as\ a\ non-linear\ mixer\ of\ three\ oscillators 8 12 0 13 #e3f0fb #1d3557 0;
#X obj 30 150 osc~ 110;
#X obj 120 150 osc~ 165;
#X obj 210 150 osc~ 220.5;
#X text 300 150 <- three inputs (a chord), f 30;
#X obj 30 270 nn.neuron~ tanh demo;
#X msg 30 180 w 1 0 0;
#X msg 101 180 w 0.5 0.5 0.5;
#X msg 214 180 w 2 -1.5 0.8;
#X msg 320 180 bias 0.5;
#X msg 398 180 bias 0;
#X msg 462 180 act tanh;
#X msg 30 208 act relu;
#X msg 108 208 act sin;
#X msg 179 208 randomize;
#X msg 264 208 seed 42 \, randomize;
#X msg 412 208 spread 2 \, randomize;
#X msg 30 236 print;
#X text 200 280 <- messages go into the LEFT inlet (with the audio). "print" writes the weights to the Pd window., f 36;
#X obj 330 350 hsl 160 15 0 20 0 1 empty empty tau\ (ms):\ leak\ /\ memory 0 -8 0 11 #fcfcfc #000000 #000000 0 1;
#X floatatom 498 349 7 0 0 0 - - - 0;
#X msg 330 376 tau \$1;
#X text 330 400 tau > 0 smooths the weighted sum before the curve: the neuron reacts slowly and remembers the past (lesson 09)., f 40;
#X text 30 350 One message box can control a whole NET (2nd argument):, f 36;
#X msg 30 386 \; nn-demo randomize;
#X text 30 426 <- same as sending "randomize" to every [nn.neuron~ ... demo], f 36;
#X obj 30 460 hip~ 5;
#X obj 30 490 nn.scope~;
#X obj 260 490 nn.spectrum~;
#X obj 560 490 *~ 0.3;
#X obj 660 116 cnv 1 430 490 empty empty REFERENCE 8 12 0 13 #eef1f5 #1d3557 0;
#X text 670 142 INLETS 1-5: signals x1 .. x5 (unused inlets count as 0). The LEFT inlet also takes messages:, f 58;
#X text 680 178 w <w1> [w2 .. w5] set weights, f 58;
#X text 680 199 bias <b> set the bias, f 58;
#X text 680 220 act <name> activation (see [nn.act~]), f 58;
#X text 680 241 tau <ms> leak time constant \, 0 = none, f 58;
#X text 680 262 randomize new random weights, f 58;
#X text 680 283 seed <n> make randomize repeatable, f 58;
#X text 680 304 spread <s> size of random weights (default 1), f 58;
#X text 680 325 print write settings to the Pd window, f 58;
#X text 670 346 OUTLET: the neuron output y (signal)., f 58;
#X text 670 367 ARGUMENTS: 1) activation (default tanh) 2) net name. Every neuron with the same net name also receives messages sent to [s nn-<net>] (default net: nn-0). At load each neuron takes the next number in its net and draws repeatable random weights from it., f 58;
#X text 670 448 SEE ALSO: [nn.act~] \, [nn.dense] \, lessons 3 \, 5 \, 8 \, 9 \, 16, f 58;
