#X obj 260 430 *~ 4;
#X obj 660 100 cnv 1 430 450 empty empty REFERENCE 8 12 0 13 #eef1f5 #1d3557 0;
#X text 670 126 LEFT INLET: input current I (signal \, try 0..20). Messages: RS \, IB \, CH \, FS \, LTS \, RZ \, TC (presets) \, abcd <a> <b> <c> <d> \, rate <ms per second> \, reset., f 58;
#X text 670 177 OUTLETS: left = v scaled (-80 mV = -1 \, +30 mV = +1) \, right = spike impulses., f 58;
#X text 670 213 ARGUMENTS: preset (default RS) \, rate (default 1000 = biological real time)., f 58;
#X text 680 249 RS (0.02 0.2 -65 8) regular spiking - the most common cortical neuron, f 58;
#X text 680 285 IB (0.02 0.2 -55 4) intrinsically bursting - a burst \, then single spikes, f 58;
#X text 680 321 CH (0.02 0.2 -50 2) chattering - fast repeating bursts, f 58;
#X text 680 357 FS (0.1 0.2 -65 2) fast spiking - inhibitory interneuron \, no slowing down, f 58;
#X text 680 393 LTS (0.02 0.25 -65 2) low-threshold spiking, f 58;
#X text 680 414 RZ (0.1 0.26 -65 2) resonator - likes inputs at its own frequency, f 58;
#X text 680 450 TC (0.02 0.25 -65 0.05) thalamo-cortical - bursts when released from negative input, f 58;
#X text 670 486 SEE ALSO: lessons/10-spiking-neurons.pd, f 58;
