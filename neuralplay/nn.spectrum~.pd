#N canvas 40 60 1000 560 12;
#X obj 10 10 cnv 1 260 104 empty empty 0\ Hz\ ->\ a\ quarter\ of\ the\ sample\ rate 4 96 0 9 #f7f7f7 #555555 0;
#N canvas 0 50 450 250 (subpatch) 0;
#X array \$0-spec 512 float 8;
#X coords 0 100 511 20 256 80 1 0 0;
#X restore 12 12 graph;
#X text 300 10 [nn.spectrum~] - a tiny spectrum analyser (FFT), f 84;
#X text 300 31 Shows which frequencies are in the signal: left = 0 Hz \, right = a quarter of the sample rate (12 kHz at 48 kHz). Height = level in dB (20..100 \, where 100 is a full-scale sine). Use it to SEE harmonics: a pure sine is one spike \, tanh adds odd harmonics \, an asymmetric curve adds even ones., f 84;
#X obj 300 113 inlet~;
#N canvas 40 60 700 460 fft 0;
#X text 20 10 Runs in blocks of 2048 samples. Each block is multiplied by a Hann window (smooth fade in/out) \, transformed by [rfft~] into 1024 frequency bins \, turned into magnitude sqrt(re^2 + im^2) \, normalised (a full-scale sine reads 1) \, converted to dB and written into the first 512 bins of the display., f 80;
#X obj 20 86 inlet~;
#X obj 100 86 tabreceive~ \$0-hann;
#X obj 20 116 *~;
#X obj 20 146 rfft~;
#X obj 20 176 *~;
#X obj 90 176 *~;
#X obj 20 206 +~;
#X obj 20 236 sqrt~;
#X obj 20 266 *~ 0.001953125;
#X text 150 266 <- 1/512: a Hann-windowed sine of amplitude 1 peaks at 2048/4, f 40;
#X obj 20 296 rmstodb~;
#X obj 20 326 clip~ 20 100;
#X obj 20 356 tabwrite~ \$0-spec;
#X obj 250 296 loadbang;
#X obj 250 326 metro 100;
#X obj 400 86 block~ 2048;
#X connect 1 0 3 0;
#X connect 2 0 3 1;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 4 0 5 1;
#X connect 4 1 6 0;
#X connect 4 1 6 1;
#X connect 5 0 7 0;
#X connect 6 0 7 1;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 9 0 11 0;
#X connect 11 0 12 0;
#X connect 12 0 13 0;
#X connect 14 0 15 0;
#X connect 15 0 13 0;
#X restore 300 143 pd fft;
#X obj 300 183 array define \$0-hann 2048;
#X text 500 183 <- the window \, computed once at load:, f 40;
#X obj 500 209 loadbang;
#X obj 500 235 t b b;
#X msg 560 261 0;
#X msg 500 261 2048;
#X obj 500 287 until;
#X obj 500 313 f;
#X obj 550 313 + 1;
#X obj 500 339 t f f;
#X obj 500 369 expr 0.5 - 0.5 * cos(6.283185 * \$f1 / 2048);
#X obj 500 399 tabwrite \$0-hann;
#X text 480 530 neuralplay - Moisés Horta Valenzuela / SEMILLA.AI Studio, f 70;
