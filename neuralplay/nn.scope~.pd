#N canvas 40 60 900 520 12;
#X obj 10 10 cnv 1 204 98 empty empty empty 4 10 0 12 #f7f7f7 #000000 0;
#X obj 12 52 cnv 1 200 1 empty empty empty 4 10 0 12 #cfcfcf #000000 0;
#N canvas 0 50 450 250 (subpatch) 0;
#X array \$0-scope 1024 float 8;
#X coords 0 1 1023 -1 200 80 1 0 0;
#X restore 12 12 graph;
#X obj 12 94 tgl 11 0 empty empty hold 14 6 0 9 #fcfcfc #000000 #000000 0 1;
#X text 250 10 [nn.scope~] - a tiny oscilloscope, f 80;
#X text 250 31 Records a stretch of the incoming signal into an array every 100 ms (or as soon as the previous recording is finished) and draws it. Tick "hold" to freeze the picture., f 80;
#X text 250 82 ARGUMENTS: 1) how many samples to show (default 1024 = about 21 ms at 48 kHz \, use 48000 to see one second of a slow LFO) 2) vertical range (default 1 = the graph shows -1..+1)., f 80;
#X obj 250 153 inlet~;
#X obj 250 183 *~ 1;
#X obj 250 213 tabwrite~ \$0-scope;
#X text 400 183 <- divide by the range so the graph always spans -1..+1, f 30;
#X obj 500 243 loadbang;
#X obj 500 269 t b b b;
#X obj 700 299 f \$2;
#X obj 700 325 expr if(\$f1 > 0 \, 1 / \$f1 \, 1);
#X obj 500 299 f \$1;
#X obj 500 325 expr if(\$f1 > 0 \, \$f1 \, 1024);
#X obj 500 351 t f f;
#X obj 560 381 array size \$0-scope;
#X obj 500 411 expr max(100 \, \$f1 / 44.1 + 20);
#X text 720 411 <- refresh time (ms): never re-trigger before the recording is complete, f 26;
#X msg 250 299 1;
#X obj 250 329 == 0;
#X text 300 329 <- hold: stop the clock, f 24;
#X obj 250 441 metro 100;
#X text 380 490 neuralplay - Moisés Horta Valenzuela / SEMILLA.AI Studio, f 70;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 11 0 12 0;
#X connect 12 2 13 0;
