#N canvas 40 60 1100 700 12;
#X obj 10 10 cnv 1 56 62 empty \$0-label tanh 4 55 0 10 #f2f2f2 #000000 0;
#X obj 14 34 cnv 1 48 1 empty empty empty 4 10 0 12 #c4c4c4 #000000 0;
#X obj 38 14 cnv 1 1 40 empty empty empty 4 10 0 12 #c4c4c4 #000000 0;
#N canvas 0 50 450 250 (subpatch) 0;
#X array \$0-view 41 float 8;
#X coords 0 2 40 -2 48 40 1 0 0;
#X restore 14 14 graph;
#X text 100 10 [nn.act~] - an ACTIVATION FUNCTION used as a WAVESHAPER, f 80;
#X text 100 31 Every artificial neuron ends with a non-linear "squashing" curve: output = f(weighted sum). In audio terms that curve is a waveshaper transfer function - like a distortion pedal \, or Le Brun / Arfib waveshaping synthesis (1979). This object lets you hear and see the curve., f 80;
#X text 100 97 HOW IT WORKS: (1) when a function name arrives \, [nn.act] evaluates the formula 2051 times for x from -8 to +8 and the results are stored in the lookup table \$0-lut. (2) the audio is clipped to +/-8 \, turned into a table index and read with 4-point interpolation. (3) a 41-point copy (x and y from -2 to +2) is drawn in the box., f 80;
#X text 100 178 MESSAGES (left inlet): linear step sign sigmoid tanh relu leaky softsign sin gauss elu gelu swish hardclip. Argument: the starting function (default tanh)., f 80;
#X text 100 243 SIGNAL PATH, f 20;
#X obj 100 267 inlet~ fwd;
#X text 190 267 <- audio in. Messages leave from the right outlet, f 28;
#X obj 100 317 clip~ -8 8;
#X text 190 317 <- the table only covers -8..+8, f 34;
#X obj 100 347 *~ 128;
#X obj 100 377 +~ 1025;
#X text 170 355 <- index = x * 128 + 1025 (128 points per unit \, x = 0 at index 1025), f 30;
#X obj 100 417 tabread4~ \$0-lut;
#X obj 100 447 outlet~;
#X text 170 447 <- f(x), f 10;
#X obj 100 487 array define \$0-lut 2051;
#X text 100 513 2051 = 2049 points for -8..+8 plus a guard point at each end for the interpolation, f 34;
#X text 430 243 THE CURVE: [nn.act] holds the formulas. Its right outlet announces every new function: then we refill the table and redraw the box., f 70;
#X obj 430 293 nn.act \$1;
#X obj 550 323 t b b a;
#X obj 780 353 list prepend label;
#X obj 780 379 list trim;
#X obj 780 405 s \$0-label;
#X text 910 379 <- shows the name, f 12;
#X text 430 443 FILL THE TABLE: a classic Pd counting loop - [until] bangs 2051 times \, [f] and [+ 1] count. Each index becomes x \, [nn.act] returns f(x) \, [tabwrite] stores it., f 64;
#X obj 430 463 t b;
#X obj 430 493 t b b;
#X msg 490 519 0;
#X msg 430 519 2051;
#X obj 430 545 until;
#X obj 430 571 f;
#X obj 480 571 + 1;
#X obj 430 597 t f f;
#X obj 430 627 expr (\$f1 - 1) / 128 - 8;
#X text 620 627 <- index -> x, f 14;
#X obj 430 683 tabwrite \$0-lut;
#X text 560 683 <- f(x) comes back from [nn.act] above, f 22;
#X text 800 443 DRAW THE BOX: 41 points \, x from -2 to +2 \, read back from the table and clipped to the box, f 36;
#X obj 800 493 t b;
#X obj 800 523 t b b;
#X msg 860 549 0;
#X msg 800 549 41;
#X obj 800 575 until;
#X obj 800 601 f;
#X obj 850 601 + 1;
#X obj 800 627 t f f;
#X obj 800 657 expr \$f1 * 12.8 + 769;
#X text 970 657 <- (k/10 - 2) * 128 + 1025, f 16;
#X obj 800 683 tabread \$0-lut;
#X obj 800 709 clip -2 2;
#X obj 800 735 tabwrite \$0-view;
#X text 580 670 neuralplay - Moisés Horta Valenzuela / SEMILLA.AI Studio, f 70;
#X connect 9 0 11 0;
#X connect 11 0 13 0;
