#N canvas 40 60 1280 760 12;
#X declare -path ..;
#X obj 0 0 cnv 1 1280 46 empty empty exercise\ 01\ \ \ A\ AND\ NOT\ B\ \ -\ \ program\ one\ neuron\ to\ play\ the\ gaps 14 23 0 20 #1d3557 #ffffff 0;
#X obj 1110 730 declare -path ..;
#X text 800 730 finds the nn.* objects one folder up ->, f 42;
#X text 20 730 neuralplay - Moisés Horta Valenzuela / SEMILLA.AI Studio, f 70;
#X text 20 56 Two rhythms \, A and B \, play all the time. Program ONE neuron so that the bell rings exactly when A plays and B does not. You may only change its two weights and its bias. When you think you have it \, press CHECK., f 175;
#X obj 10 96 cnv 1 390 620 empty empty THE\ TASK 8 12 0 13 #eef1f5 #1d3557 0;
#X text 20 122 The neuron [nn.neuron~ step ex01] fires (outputs 1) when, f 52;
#X text 30 158 w1 * A + w2 * B + bias > 0, f 52;
#X text 20 179 A and B are 0 or 1 - fill in the table in your head: which of the four cases (A \, B) = (0 \, 0) (0 \, 1) (1 \, 0) (1 \, 1) must fire? Which weight must be positive (excitatory) \, which negative (inhibitory)? Where does the threshold go?, f 52;
#X text 20 260 HOW: edit the message box [w 0 0 \, bias 0( in the PLAY panel (edit mode \, double-click it \, type numbers \, leave edit mode) \, then click it. Watch the OUT light \, listen \, press CHECK., f 52;
#X text 20 326 STUCK? Lesson 1 (McCulloch-Pitts) and lesson 4 (the perceptron) use the same idea. The solution is inside [pd solution] - try first!, f 52;
#N canvas 40 60 800 300 solution 0;
#X text 20 10 SOLUTION: A must excite (w1 = 1) \, B must inhibit (w2 = -1) \, and the bias must be between -1 and 0 so that A alone fires but nothing else does: bias -0.5. Click the message (or send [ \, ex01-solution bang( from anywhere)., f 100;
#X obj 20 90 r ex01-solution;
#X msg 20 120 \; nn-ex01 w 1 -1 \; nn-ex01 bias -0.5;
#X connect 1 0 2 0;
#X restore 30 640 pd solution;
#X text 130 640 <- the solution (try first!), f 30;
#X obj 410 96 cnv 1 430 620 empty empty PLAY 8 12 0 13 #e3f0fb #1d3557 0;
#X text 430 130 the two rhythms A (2 pulses per second) and B (3) \, open the box to see how they are made, f 40;
#N canvas 40 60 800 300 rhythms 0;
#X text 20 10 A and B: a [phasor~] ramp 0..1 becomes a square wave with [expr~ \$v1 < 0.5] (1 for the first half of each cycle \, 0 for the second). The outlets feed the neuron directly \, [s~ \$0-A] and [s~ \$0-B] feed the lights \, the sounds and the check. (Direct wires keep the neuron in step with the check: [r~] can lag one block of 64 samples.), f 100;
#X obj 20 90 phasor~ 2;
#X obj 20 120 expr~ \$v1 < 0.5;
#X obj 20 160 outlet~;
#X obj 120 160 s~ \$0-A;
#X obj 220 90 phasor~ 3;
#X obj 220 120 expr~ \$v1 < 0.5;
#X obj 220 160 outlet~;
#X obj 320 160 s~ \$0-B;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 2 0 4 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 6 0 8 0;
#X restore 560 180 pd rhythms;
#X obj 560 270 nn.neuron~ step ex01;
#X obj 560 360 s~ \$0-OUT;
#X obj 430 214 loadbang;
#X msg 430 240 w 0 0 \, bias 0;
#X text 430 290 ^ YOUR ANSWER: edit me \, then click me, f 16;
#X obj 510 410 r~ \$0-A;
#X obj 600 410 r~ \$0-B;
#X obj 690 410 r~ \$0-OUT;
#X obj 430 440 metro 30;
#X obj 430 414 loadbang;
#X obj 510 440 snapshot~;
#X obj 510 466 > 0.5;
#X obj 510 492 tgl 22 0 empty empty A 25 11 0 11 #ffe066 #000000 #000000 0 1;
#X obj 600 440 snapshot~;
#X obj 600 466 > 0.5;
#X obj 600 492 tgl 22 0 empty empty B 25 11 0 11 #ffe066 #000000 #000000 0 1;
#X obj 690 440 snapshot~;
#X obj 690 466 > 0.5;
#X obj 690 492 tgl 22 0 empty empty OUT 25 11 0 11 #ffe066 #000000 #000000 0 1;
#X text 430 530 A \, B: the two rhythms. OUT: what your neuron plays., f 50;
#X obj 850 96 cnv 1 420 280 empty empty CHECK 8 12 0 13 #e6f6e9 #1d3557 0;
#X obj 870 136 bng 40 250 50 0 empty ex01-check CHECK 46 20 0 16 #ffd8a8 #000000 #000000;
#N canvas 40 60 1100 640 check-my-answer 0;
#X text 20 10 THE CHECK: for 3 seconds \, every 10 ms \, compare what the neuron plays (OUT) with what it should play (A is on AND B is off) \, and count the moments where they differ. 0 wrong = solved., f 140;
#X obj 20 60 inlet;
#X obj 100 60 r ex01-check;
#X obj 20 90 t b b;
#X msg 300 120 0 0;
#X obj 300 146 unpack f f;
#X obj 300 172 v mis_\$0;
#X obj 380 172 v tot_\$0;
#X obj 20 130 metro 10;
#X obj 20 160 t b b b;
#X obj 20 196 r~ \$0-A;
#X obj 20 226 snapshot~;
#X obj 20 252 v a_\$0;
#X obj 140 196 r~ \$0-B;
#X obj 140 226 snapshot~;
#X obj 140 252 v b_\$0;
#X obj 260 196 r~ \$0-OUT;
#X obj 260 226 snapshot~;
#X obj 260 252 v o_\$0;
#X text 400 226 <- 1) read A \, B and the neuron output at the same moment, f 30;
#X obj 20 300 expr mis_\$0 + (((a_\$0 > 0.5) && (b_\$0 < 0.5)) != (o_\$0 > 0.5)) \; tot_\$0 + 1, f 60;
#X obj 20 350 v mis_\$0;
#X obj 140 350 v tot_\$0;
#X text 560 300 <- 2) wrong if (A and not B) differs from OUT, f 30;
#X obj 20 390 expr tot_\$0 >= 300;
#X obj 20 416 sel 1;
#X obj 20 442 t b b;
#X msg 200 468 stop;
#X obj 20 480 expr mis_\$0;
#X obj 20 510 print ex01-wrong-moments;
#X obj 200 510 s \$0-mis;
#X obj 320 510 == 0;
#X obj 320 536 s \$0-solved;
#X obj 440 536 print ex01-solved;
#X text 440 566 <- every exercise prints <name>-solved: 1 or 0 (dev/check.py tests this), f 34;
#X text 560 442 <- 3) after 300 samples: stop \, show and print the result, f 30;
