#X obj 480 213 t a a;
#X obj 580 343 list append;
#X text 670 343 <- holds the new name until it is checked, f 26;
#X obj 480 253 route linear step sign sigmoid tanh relu leaky softsign sin gauss elu gelu swish hardclip;
