#N canvas 40 60 1100 640 12;
#X text 20 10 [nn.act] - an activation function for numbers (control rate), f 110;
#X text 20 31 Send a number x \, get f(x). Send a function name to switch: linear step sign sigmoid tanh relu leaky softsign sin gauss elu gelu swish hardclip. The formulas \, each with a bit of history \, are inside [pd formulas]. [nn.act~] (audio) and [nn.dense] (a whole layer) both use this object \, so every curve exists in exactly one place., f 110;
#X text 20 97 OUTLETS: left = f(x) \, right = the name of the function each time it changes (so other objects can react). ARGUMENT: the starting function (default tanh)., f 110;
#X obj 20 143 inlet;
#X obj 20 173 route float;
#X text 120 173 <- numbers go left \, names go right, f 40;
#X obj 20 213 list prepend tanh;
#X obj 20 239 list trim;
#N canvas 40 60 1240 820 formulas 0;
#X text 20 10 THE FORMULAS - one [expr] per activation function \, with a little history. x arrives as "name value": [route] sends the value to the matching formula \, the result leaves through the outlet. Want a new curve? Add a name here AND in the [route] of the main patch., f 110;
#X obj 20 65 inlet;
#X obj 20 95 route linear step sign sigmoid tanh relu leaky softsign sin gauss elu gelu swish hardclip;
#X obj 20 769 outlet;
#X obj 60 125 expr \$f1;
#X text 660 125 linear: identity. A neuron with no non-linearity: stacking linear layers is still linear \, so a deep linear net = one layer., f 76;
#X obj 60 171 expr \$f1 > 0;
#X text 660 171 step: Heaviside step: 1 if x > 0 \, else 0 - McCulloch & Pitts (1943) \, Rosenblatt perceptron (1958). Audio: 1-bit / square-wave fuzz., f 76;
#X obj 60 217 expr (\$f1 > 0) * 2 - 1;
#X text 660 217 sign: bipolar step (+1/-1). Hopfield networks (1982). Audio: hard square \, like a comparator., f 76;
#X obj 60 263 expr 1 / (1 + exp(-\$f1));
#X text 660 263 sigmoid: logistic curve 0..1. Made backpropagation possible (Rumelhart \, Hinton & Williams 1986). Output is never negative: adds DC offset., f 76;
#X obj 60 309 expr tanh(\$f1);
#X text 660 309 tanh: hyperbolic tangent -1..1. The classic of 1990s nets and LSTMs (1997). Audio: the classic soft-clipping saturation curve., f 76;
#X obj 60 355 expr max(\$f1 \, 0);
#X text 660 355 relu: rectified linear unit. Nair & Hinton 2010 \, Glorot 2011 \, AlexNet 2012: the deep-learning boom. Audio: half-wave rectifier., f 76;
#X obj 60 401 expr max(\$f1 \, 0.1 * \$f1);
#X text 660 401 leaky: leaky ReLU (Maas et al. 2013): small slope for x < 0 so neurons never fully "die"., f 76;
#X obj 60 447 expr \$f1 / (1 + abs(\$f1));
#X text 660 447 softsign: softsign: like tanh but with slower \, polynomial tails. Gentle saturation., f 76;
#X obj 60 493 expr sin(\$f1);
#X text 660 493 sin: sine activation (SIREN \, Sitzmann et al. 2020). Audio: a WAVEFOLDER \, the more you drive it the more it folds., f 76;
#X obj 60 539 expr exp(-\$f1 * \$f1);
#X text 660 539 gauss: gaussian bump: radial-basis-function networks (Broomhead & Lowe 1988). Even function: doubles the frequency (octave up)., f 76;
#X obj 60 585 expr if(\$f1 > 0 \, \$f1 \, exp(\$f1) - 1);
#X text 660 585 elu: exponential linear unit (Clevert et al. 2015). Smooth ReLU that can go a little negative., f 76;
#X obj 60 631 expr 0.5 * \$f1 * (1 + tanh(0.7978846 * (\$f1 + 0.044715 * \$f1 * \$f1 * \$f1)));
#X text 660 631 gelu: Gaussian error linear unit (Hendrycks & Gimpel 2016): used in BERT and GPT transformers., f 76;
#X obj 60 677 expr \$f1 / (1 + exp(-\$f1));
#X text 660 677 swish: swish / SiLU (Elfwing 2017 \, Ramachandran 2017): x times sigmoid(x). Used in many modern nets., f 76;
#X obj 60 723 expr min(max(\$f1 \, -1) \, 1);
#X text 660 723 hardclip: hard tanh: straight line clipped at -1/+1. Exactly what a digital mixer does when you go over 0 dB., f 76;
