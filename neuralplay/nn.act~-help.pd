#X floatatom 198 179 7 0 0 0 - - - 0;
#X obj 30 220 hsl 160 15 -2 2 0 1 empty empty offset\ (a\ bias) 0 -8 0 11 #fcfcfc #000000 #000000 8000 1;
#X floatatom 198 219 7 0 0 0 - - - 0;
