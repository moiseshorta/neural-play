#X msg 94 252 step;
#X msg 144 252 sign;
#X msg 194 252 sigmoid;
#X msg 265 252 tanh;
#X msg 315 252 relu;
#X msg 365 252 leaky;
#X msg 30 280 softsign;
#X msg 108 280 sin;
#X msg 151 280 gauss;
#X msg 208 280 elu;
#X msg 251 280 gelu;
#X msg 301 280 swish;
#X msg 358 280 hardclip;
#X text 390 326 <- the curve. Click any name above., f 22;
#X obj 300 390 hip~ 5;
#X text 360 390 <- [hip~] removes DC (sigmoid \, relu \, gauss push the wave off centre), f 40;
#X obj 30 426 nn.scope~;
#X obj 260 426 nn.spectrum~;
#X obj 560 426 *~ 0.3;
#X obj 660 100 cnv 1 430 450 empty empty REFERENCE 8 12 0 13 #eef1f5 #1d3557 0;
#X text 670 126 LEFT INLET: signal x \, or a function name: linear \, step \, sign \, sigmoid \, tanh \, relu \, leaky \, softsign \, sin \, gauss \, elu \, gelu \, swish \, hardclip., f 58;
#X text 670 177 OUTLET: f(x)., f 58;
#X text 670 198 ARGUMENT: start function (default tanh)., f 58;
#X text 670 219 HOW: the formula is written into a 2049-point table covering x = -8 .. +8 \, the signal reads it with 4-point interpolation (inputs outside +/-8 are held at the ends). Open the object to see the patch \, and [pd formulas] inside it for every formula with its history., f 58;
#X text 670 315 LISTEN FOR: tanh / softsign = warm saturation (odd harmonics). step / sign = square wave. relu = half-wave rectifier (even harmonics + DC). gauss = octave up (an even function folds both halves the same way). sin with a high drive = wavefolder., f 58;
#X text 670 396 SEE ALSO: [nn.act] (numbers) \, [nn.neuron~] \, lessons/02-activation-functions.pd, f 58;
