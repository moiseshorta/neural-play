#N canvas 40 60 1000 560 12;
#X obj 0 0 cnv 1 1000 46 empty empty nn.act\ \ -\ \ activation\ function\ for\ numbers 14 23 0 20 #1d3557 #ffffff 0;
#X text 20 56 Number in \, f(number) out. The same 14 curves as [nn.act~] \, for control-rate networks (see [nn.dense]) and for experiments with plain numbers. The right outlet reports the new function name every time it changes., f 130;
#X obj 10 100 cnv 1 560 400 empty empty TRY\ IT 8 12 0 13 #e3f0fb #1d3557 0;
#X floatatom 30 140 8 0 0 1 x - - 0;
#X obj 30 180 nn.act tanh;
#X floatatom 30 220 10 0 0 1 f(x) - - 0;
#X obj 160 220 print nn.act-is-now;
#X text 140 140 <- drag or type a number, f 30;
#X msg 30 270 linear;
#X msg 94 270 step;
#X msg 144 270 sign;
#X msg 194 270 sigmoid;
#X msg 265 270 tanh;
#X msg 315 270 relu;
#X msg 365 270 leaky;
#X msg 422 270 softsign;
#X msg 500 270 sin;
#X msg 30 298 gauss;
#X msg 87 298 elu;
#X msg 130 298 gelu;
#X msg 180 298 swish;
#X msg 237 298 hardclip;
#X text 30 360 Plot a curve yourself: a counting loop feeds x = -4 .. +4 and stores f(x) in an array. That is exactly what [nn.act~] does inside., f 70;
#X obj 580 100 cnv 1 410 400 empty empty REFERENCE 8 12 0 13 #eef1f5 #1d3557 0;
#X text 590 126 LEFT INLET: a number x \, or a function name (linear \, step \, sign \, sigmoid \, tanh \, relu \, leaky \, softsign \, sin \, gauss \, elu \, gelu \, swish \, hardclip)., f 56;
#X text 590 177 LEFT OUTLET: f(x). RIGHT OUTLET: the function name after every change., f 56;
#X text 590 213 ARGUMENT: start function (default tanh)., f 56;
#X text 590 234 Open the object and then [pd formulas] for every formula with a short history., f 56;
#X text 590 270 SEE ALSO: [nn.act~] \, [nn.dense] \, [nn.neuron~], f 56;
#X text 20 520 neuralplay - Moisés Horta Valenzuela / SEMILLA.AI Studio - open lessons/ and 00-START-HERE.pd for the full course, f 120;
