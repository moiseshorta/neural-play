#N canvas 40 60 1150 720 12;
#X text 20 10 [nn.izh~] - a SPIKING neuron: the Izhikevich model (2003) \, running at audio rate, f 100;
#X text 20 31 Real neurons talk in spikes. Izhikevich found that two equations reproduce almost every firing pattern of cortical neurons: v = membrane voltage (mV) \, u = slow recovery current \, I = input current. Every time step: v += dt * (0.04 v^2 + 5 v + 140 - u + I) and u += dt * a * (b v - u). When v reaches +30 mV the neuron SPIKES: v jumps back to c and u grows by d., f 100;
#X text 20 97 RATE = how many milliseconds of "neuron time" pass per second of audio. 1000 = biological real time (spikes are rhythms). 10000-50000 = sped up into audio: the spike train becomes a pitched tone., f 100;
#X text 20 148 LEFT INLET: input current I as a signal (try 0..20) + messages: a preset name (RS \, IB \, CH \, FS \, LTS \, RZ \, TC) \, "abcd <a> <b> <c> <d>" \, "rate <ms per second>" \, "reset". ARGUMENTS: preset (default RS) \, rate (default 1000)., f 100;
#X text 20 199 OUTLETS: left = membrane voltage scaled to about -1..+1 (v = -80 mV -> -1 \, +30 mV -> +1) \, right = spikes (a single sample of 1.0 per spike \, perfect for pinging a resonant filter)., f 100;
#X obj 20 251 inlet~ fwd;
#X text 110 251 <- input current I, f 20;
#X obj 20 401 fexpr~ if(\$y1 >= 30 \, \$f4 \, min(30 \, \$y1 + \$f6 * (0.04 * \$y1 * \$y1 + 5 * \$y1 + 140 - \$y2 + \$x1))) \; if(\$y1 >= 30 \, \$y2 + \$f5 \, \$y2 + \$f6 * \$f2 * (\$f3 * \$y1 - \$y2)) \; \$y1 >= 30, f 110;
#X text 20 461 [fexpr~] evaluates the formulas once per sample and can read its own previous outputs: \$y1 = v one sample ago \, \$y2 = u one sample ago. \$x1 = input current \, \$f2..\$f5 = a b c d \, \$f6 = dt (ms per sample). Outlet 1 = v \, outlet 2 = u \, outlet 3 = 1 when a spike happens. v is clipped at +30 so a big time step cannot explode., f 110;
#X obj 20 541 expr~ (\$v1 + 25) / 55;
#X text 190 541 <- scale v to about -1..+1, f 30;
#X obj 20 571 outlet~;
#X obj 700 571 outlet~;
#X text 770 571 <- spikes, f 12;
#X obj 330 281 route RS IB CH FS LTS RZ TC abcd rate reset;
#X obj 330 361 unpack f f f f;
#X msg 330 311 0.02 0.2 -65 8;
#X msg 440 311 0.02 0.2 -55 4;
#X msg 550 311 0.02 0.2 -50 2;
#X msg 660 311 0.1 0.2 -65 2;
#X msg 770 311 0.02 0.25 -65 2;
#X msg 880 311 0.1 0.26 -65 2;
#X msg 990 311 0.02 0.25 -65 0.05;
#X text 800 361 -> a b c d, f 12;
#X obj 900 311 t b f;
#X obj 950 337 v rate_\$0;
#X obj 900 337 samplerate~;
#X obj 900 363 expr rate_\$0 / \$f1;
#X text 900 387 dt = rate / sample rate (ms per sample), f 22;
#X msg 1020 363 set -65 -13 0;
#X obj 560 387 print nn.izh~-unknown-message;
#X text 20 631 AT LOAD: preset from argument 1 (or RS) \, rate from argument 2 (or 1000) \, then start from rest (v = -65 mV)., f 100;
#X obj 20 661 loadbang;
#X obj 20 687 t b b b;
#X obj 300 717 list append \$1;
#X obj 300 743 list trim;
#X obj 300 769 route float;
#X msg 300 795 RS;
#X obj 150 717 f \$2;
#X obj 150 743 expr if(\$f1 > 0 \, \$f1 \, 1000);
#X msg 150 769 rate \$1;
#X msg 20 717 reset;
#X text 600 661 PRESETS (a b c d) from Izhikevich 2003:, f 50;
#X text 600 683 RS (0.02 0.2 -65 8): regular spiking - the most common cortical neuron, f 76;
#X text 600 703 IB (0.02 0.2 -55 4): intrinsically bursting - a burst \, then single spikes, f 76;
#X text 600 723 CH (0.02 0.2 -50 2): chattering - fast repeating bursts, f 76;
#X text 600 743 FS (0.1 0.2 -65 2): fast spiking - inhibitory interneuron \, no slowing down, f 76;
#X text 600 763 LTS (0.02 0.25 -65 2): low-threshold spiking, f 76;
#X text 600 783 RZ (0.1 0.26 -65 2): resonator - likes inputs at its own frequency, f 76;
#X text 600 803 TC (0.02 0.25 -65 0.05): thalamo-cortical - bursts when released from negative input, f 76;
#X text 630 690 neuralplay - Moisés Horta Valenzuela / SEMILLA.AI Studio, f 70;
