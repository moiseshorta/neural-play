#X obj 280 322 t f f;
#X obj 350 348 v k_\$0;
#X obj 280 378 expr -0.5 + (\$f1 % 12 + 0.5) * 2 / 12 \; 1.5 - (int(\$f1 / 12) + 0.5) * 2 / 12;
#X obj 280 408 pack f f;
#X obj 280 438 outlet;
#X text 340 438 <- "x1 x2" of cell k (row by row from the top left), f 50;
#X obj 780 218 t f b;
#X obj 880 248 v k_\$0;
