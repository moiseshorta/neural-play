#X text 20 10 THE MAIN LOOP: every note (metro) first runs n GAN steps ([until] n times) \, then announces the note ([s \$0-tick]) so the voices play the last real and fake pitch and the pictures update., f 110;
#X obj 20 70 inlet;
#X obj 20 100 metro 250;
#X obj 120 70 r \$0-noteperiod;
#X obj 300 70 r \$0-steps;
#X obj 300 100 v steps_\$0;
#X obj 20 130 t b b;
#X obj 100 160 v steps_\$0;
#X obj 100 186 until;
#N canvas 40 60 1250 760 one-gan-step 0;
#X text 20 10 ONE TRAINING STEP of the GAN (right to left: 1 -> 5). Pitches are scaled to x = (MIDI - 60) / 12 \, so one unit = one octave. The generator turns noise into a pitch: x_fake = mu + s * z. The discriminator judges a pitch: D(x) = sigmoid(a x + b x^2 + c) = its belief that x is real., f 170;
#X obj 20 70 inlet;
#X obj 20 96 t b b b b b;
#X text 720 140 1) draw noise z and a REAL pitch from the teacher (mean \, spread \, optional second peak 7 semitones up/down), f 70;
#X obj 20 140 t b b;
#X obj 60 170 expr sqrt(-2 * log((float(random(0 \, 32767)) + 1) / 32768)) * cos(6.283185 * float(random(0 \, 32767)) / 32768), f 80;
#X obj 620 170 v z_\$0;
#X obj 60 218 expr mr_\$0 + sr_\$0 * sqrt(-2 * log((float(random(0 \, 32767)) + 1) / 32768)) * cos(6.283185 * float(random(0 \, 32767)) / 32768) + bim_\$0 * 0.583 * (2 * random(0 \, 2) - 1), f 80;
#X obj 620 218 v xr_\$0;
#X text 720 292 2) the generator makes a FAKE pitch: x_fake = mu + s * z, f 70;
#X obj 20 292 t b;
#X obj 60 322 expr gm_\$0 + gs_\$0 * z_\$0, f 80;
#X obj 620 322 v xf_\$0;
#X text 720 364 3) train the DISCRIMINATOR: push D(real) towards 1 and D(fake) towards 0 (gradient ascent on log D(real) + log(1 - D(fake))), f 70;
#X obj 20 364 t b b;
#X obj 60 394 expr 1 / (1 + exp(-(da_\$0 * xr_\$0 + db_\$0 * xr_\$0 * xr_\$0 + dc_\$0))) \; 1 / (1 + exp(-(da_\$0 * xf_\$0 + db_\$0 * xf_\$0 * xf_\$0 + dc_\$0))), f 80;
#X obj 620 394 v dr_\$0;
#X obj 620 416 v df_\$0;
#X obj 60 448 expr da_\$0 + lrd_\$0 * ((1 - dr_\$0) * xr_\$0 - df_\$0 * xf_\$0) \; db_\$0 + lrd_\$0 * ((1 - dr_\$0) * xr_\$0 * xr_\$0 - df_\$0 * xf_\$0 * xf_\$0) \; dc_\$0 + lrd_\$0 * ((1 - dr_\$0) - df_\$0), f 80;
#X obj 620 448 v da_\$0;
#X obj 620 470 v db_\$0;
#X obj 620 492 v dc_\$0;
#X text 720 534 4) train the GENERATOR to fool the new discriminator: move mu and s in the direction that raises D(fake). The slope of D at the fake pitch is (1 - D) * (a + 2 b x)., f 70;
#X obj 20 534 t b b;
#X obj 60 564 expr (1 - 1 / (1 + exp(-(da_\$0 * xf_\$0 + db_\$0 * xf_\$0 * xf_\$0 + dc_\$0)))) * (da_\$0 + 2 * db_\$0 * xf_\$0), f 80;
#X obj 620 564 v g_\$0;
#X obj 60 612 expr gm_\$0 + lrg_\$0 * g_\$0 \; max(gs_\$0 + lrg_\$0 * g_\$0 * z_\$0 \, 0.01), f 80;
#X obj 620 612 v gm_\$0;
#X obj 620 634 v gs_\$0;
#X text 720 676 5) remember both pitches in the histograms, f 70;
