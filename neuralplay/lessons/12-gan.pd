#X text 1050 226 BOTTOM: the critic's belief D(pitch): 1 = "surely real" \, 0 = "surely fake"., f 30;
#X text 430 410 One GAN step = one real note \, one fake note \, one small change to the critic \, one small change to the forger., f 90;
#X obj 410 536 cnv 1 430 450 empty empty TRAIN 8 12 0 13 #e3f0fb #1d3557 0;
