#X text 20 10 THE NEURON \, one sample at a time \, at 1/8 of the sample rate ([block~ 64 1 0.125]: 6 kHz when Pd runs at 48 kHz) \, like the LPC of telephones - 8 weights then see 1.3 ms \, enough for the resonances of a voice. Top: the average power of the last 20 ms (120 samples \, a leaky average of x^2) and k = the larger of x[n-1]^2 + ... + x[n-8]^2 and 8 x that average (+ 0.000001 \, so silence divides by something) - a pulse after a quiet moment then does not kick the weights. Big [fexpr~]: outputs 1 .. 8 = the weights \, output 9 = the guess \, each weight w_k = w_k + mu * (x[n] - guess) * x[n-k] / k \, clipped to -4 .. 4 (\$y1[-1] .. \$y8[-1] = the weights one sample ago \, \$x1[-k] = the input k samples ago). Bottom: the cross-synthesis filter y[n] = exc[n] + w1 y[n-1] + ... + w8 y[n-8] \, each weight shrunk by 0.995^k (resonances pulled inside \, safer) and tanh against runaway., f 170;
#X obj 1050 110 block~ 64 1 0.125;
#X obj 20 110 inlet~;
#X obj 140 110 fexpr~ \$y1[-1] + (\$x1[-1] * \$x1[-1] - \$y1[-1]) / 120, f 26;
#X obj 400 110 fexpr~ 1e-06 + max(\$x1[-1] * \$x1[-1] + \$x1[-2] * \$x1[-2] + \$x1[-3] * \$x1[-3] + \$x1[-4] * \$x1[-4] + \$x1[-5] * \$x1[-5] + \$x1[-6] * \$x1[-6] + \$x1[-7] * \$x1[-7] + \$x1[-8] * \$x1[-8] \, 8 * \$x2[0]), f 60;
#X obj 20 210 fexpr~ max(-4 \, min(4 \, \$y1[-1] + mu_\$0 * (\$x1[0] - (\$y1[-1] * \$x1[-1] + \$y2[-1] * \$x1[-2] + \$y3[-1] * \$x1[-3] + \$y4[-1] * \$x1[-4] + \$y5[-1] * \$x1[-5] + \$y6[-1] * \$x1[-6] + \$y7[-1] * \$x1[-7] + \$y8[-1] * \$x1[-8])) * \$x1[-1] / \$x2[0])) \; max(-4 \, min(4 \, \$y2[-1] + mu_\$0 * (\$x1[0] - (\$y1[-1] * \$x1[-1] + \$y2[-1] * \$x1[-2] + \$y3[-1] * \$x1[-3] + \$y4[-1] * \$x1[-4] + \$y5[-1] * \$x1[-5] + \$y6[-1] * \$x1[-6] + \$y7[-1] * \$x1[-7] + \$y8[-1] * \$x1[-8])) * \$x1[-2] / \$x2[0])) \; max(-4 \, min(4 \, \$y3[-1] + mu_\$0 * (\$x1[0] - (\$y1[-1] * \$x1[-1] + \$y2[-1] * \$x1[-2] + \$y3[-1] * \$x1[-3] + \$y4[-1] * \$x1[-4] + \$y5[-1] * \$x1[-5] + \$y6[-1] * \$x1[-6] + \$y7[-1] * \$x1[-7] + \$y8[-1] * \$x1[-8])) * \$x1[-3] / \$x2[0])) \; max(-4 \, min(4 \, \$y4[-1] + mu_\$0 * (\$x1[0] - (\$y1[-1] * \$x1[-1] + \$y2[-1] * \$x1[-2] + \$y3[-1] * \$x1[-3] + \$y4[-1] * \$x1[-4] + \$y5[-1] * \$x1[-5] + \$y6[-1] * \$x1[-6] + \$y7[-1] * \$x1[-7] + \$y8[-1] * \$x1[-8])) * \$x1[-4] / \$x2[0])) \; max(-4 \, min(4 \, \$y5[-1] + mu_\$0 * (\$x1[0] - (\$y1[-1] * \$x1[-1] + \$y2[-1] * \$x1[-2] + \$y3[-1] * \$x1[-3] + \$y4[-1] * \$x1[-4] + \$y5[-1] * \$x1[-5] + \$y6[-1] * \$x1[-6] + \$y7[-1] * \$x1[-7] + \$y8[-1] * \$x1[-8])) * \$x1[-5] / \$x2[0])) \; max(-4 \, min(4 \, \$y6[-1] + mu_\$0 * (\$x1[0] - (\$y1[-1] * \$x1[-1] + \$y2[-1] * \$x1[-2] + \$y3[-1] * \$x1[-3] + \$y4[-1] * \$x1[-4] + \$y5[-1] * \$x1[-5] + \$y6[-1] * \$x1[-6] + \$y7[-1] * \$x1[-7] + \$y8[-1] * \$x1[-8])) * \$x1[-6] / \$x2[0])) \; max(-4 \, min(4 \, \$y7[-1] + mu_\$0 * (\$x1[0] - (\$y1[-1] * \$x1[-1] + \$y2[-1] * \$x1[-2] + \$y3[-1] * \$x1[-3] + \$y4[-1] * \$x1[-4] + \$y5[-1] * \$x1[-5] + \$y6[-1] * \$x1[-6] + \$y7[-1] * \$x1[-7] + \$y8[-1] * \$x1[-8])) * \$x1[-7] / \$x2[0])) \; max(-4 \, min(4 \, \$y8[-1] + mu_\$0 * (\$x1[0] - (\$y1[-1] * \$x1[-1] + \$y2[-1] * \$x1[-2] + \$y3[-1] * \$x1[-3] + \$y4[-1] * \$x1[-4] + \$y5[-1] * \$x1[-5] + \$y6[-1] * \$x1[-6] + \$y7[-1] * \$x1[-7] + \$y8[-1] * \$x1[-8])) * \$x1[-8] / \$x2[0])) \; \$y1[-1] * \$x1[-1] + \$y2[-1] * \$x1[-2] + \$y3[-1] * \$x1[-3] + \$y4[-1] * \$x1[-4] + \$y5[-1] * \$x1[-5] + \$y6[-1] * \$x1[-6] + \$y7[-1] * \$x1[-7] + \$y8[-1] * \$x1[-8], f 125;
