#N canvas 40 60 1280 980 12;
#X declare -path ..;
#X obj 0 0 cnv 1 1280 46 empty empty 05\ \ \ Hidden\ layers\ \ -\ \ solving\ XOR\ (and\ why\ backprop\ mattered\,\ 1986) 14 23 0 20 #1d3557 #ffffff 0;
#X obj 1110 950 declare -path ..;
#X text 800 950 finds the nn.* objects one folder up ->, f 42;
#X text 20 950 neuralplay - Moisés Horta Valenzuela / SEMILLA.AI Studio, f 70;
#X text 20 56 One neuron can only draw one straight border \, and XOR needs two. Add a HIDDEN LAYER: two neurons each draw a border \, a third combines them. The inputs are two rhythms A and B \, the output is their XOR - and sped up into audio it becomes a ring modulator., f 175;
#X obj 10 96 cnv 1 390 600 empty empty THE\ TRICK 8 12 0 13 #eef1f5 #1d3557 0;
#X text 20 122 h1 = OR(A \, B): weights 1 1 \, bias -0.5. Fires if at least one input is on., f 52;
#X text 20 158 h2 = AND(A \, B): weights 1 1 \, bias -1.5. Fires only if both are on., f 52;
#X text 20 194 out = h1 AND NOT h2: weights 1 -1 \, bias -0.5. "One of them \, but not both" = XOR., f 52;
#X text 20 230 The hidden neurons describe the input in a new way. In that new description XOR is easy: one straight line separates it. This is the whole idea of deep learning - every layer finds a more useful representation., f 52;
#X text 20 311 Who chooses the hidden weights? Here: you \, by hand. In 1986 Rumelhart \, Hinton and Williams popularised BACKPROPAGATION \, which learns them from examples by sending the error backwards through the layers (lesson 06). It needs smooth activations like sigmoid or tanh: a step has no slope to follow., f 52;
#X text 20 422 MUSIC: with bipolar square waves (+1 / -1) XOR is the same as multiplying them - ring modulation. Turn up "speed" and the XOR network becomes a 1-bit ring modulator., f 52;
#X obj 410 96 cnv 1 430 600 empty empty THE\ NETWORK 8 12 0 13 #e3f0fb #1d3557 0;
#X obj 430 140 hsl 130 15 0.25 20 1 1 empty l05-rateA A:\ pulses\ per\ second 0 -8 0 11 #fcfcfc #000000 #000000 6100 1;
#X floatatom 568 139 7 0 0 0 - - - 0;
#X obj 430 180 hsl 130 15 0.25 20 1 1 empty l05-rateB B:\ pulses\ per\ second 0 -8 0 11 #fcfcfc #000000 #000000 7300 1;
#X floatatom 568 179 7 0 0 0 - - - 0;
#X obj 430 220 hsl 130 15 1 200 1 1 empty l05-speed speed\ x\ (into\ audio) 0 -8 0 11 #fcfcfc #000000 #000000 0 1;
#X floatatom 568 219 7 0 0 0 - - - 0;
