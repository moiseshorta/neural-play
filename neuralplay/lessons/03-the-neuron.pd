#X msg 520 364 \$1 20;
#X obj 520 390 line~;
#X obj 610 220 vsl 17 110 -2 2 0 1 \$0-w3 l03-w3 w3 0 -9 0 12 #8ee68e #000000 #000000 6300 1;
#X floatatom 610 338 5 0 0 0 - - - 0;
#X msg 610 364 \$1 20;
#X obj 610 390 line~;
#X obj 700 220 vsl 17 110 -2 2 0 1 \$0-b l03-bias bias 0 -9 0 12 #c49be8 #000000 #000000 5400 1;
#X floatatom 700 338 5 0 0 0 - - - 0;
#X msg 700 364 \$1 20;
#X obj 700 390 line~;
#X text 800 220 <- weights: drag the faders (-2..+2), f 8;
#X obj 430 430 *~;
#X obj 520 430 *~;
#X obj 610 430 *~;
#X text 700 430 <- x * w, f 10;
#X obj 430 470 +~;
#X text 480 470 <- SUM + BIAS: three signals in one inlet are added \, the bias comes in on the right, f 44;
#X obj 430 510 expr~ tanh(\$v1);
#X text 560 510 <- f = tanh \, the activation, f 30;
#X obj 430 550 nn.scope~;
#X text 650 560 <- output of the hand-made neuron, f 16;
#X obj 850 96 cnv 1 420 610 empty empty THE\ SAME\,\ IN\ ONE\ BOX 8 12 0 13 #e3f0fb #1d3557 0;
#X obj 870 170 nn.neuron~ tanh l03;
#X text 1030 170 <- the faces of the box are the same weights and bias \, and the tanh curve, f 26;
#X obj 870 260 tgl 19 1 \$0-link l03-link link:\ copy\ the\ left\ faders 24 10 0 12 #fcfcfc #000000 #000000 1 1;
#N canvas 40 60 800 400 link 0;
#X text 20 10 Collects the four faders on the left (they send to \$0-w1 \, \$0-w2 \, \$0-w3 \, \$0-b) into one message "w <w1> <w2> <w3> \, bias <b>" for [nn.neuron~]. Any fader triggers an update: [t b f] stores the value \, then bangs [pack]., f 100;
#X obj 20 160 pack f f f f;
#X obj 20 70 r \$0-w1;
#X obj 160 70 r \$0-w2;
#X obj 160 100 t b f;
#X obj 300 70 r \$0-w3;
#X obj 300 100 t b f;
#X obj 440 70 r \$0-b;
#X obj 440 100 t b f;
#X obj 20 190 spigot 1;
#X obj 120 190 r \$0-link;
#X msg 20 220 w \$1 \$2 \$3 \, bias \$4;
#X obj 20 250 outlet;
#X text 200 220 <- only while "link" is on ([spigot 1] starts open \, so the faders reach the neuron at load), f 40;
