#N canvas 40 60 1200 900 one-update 0;
#X text 20 10 ONE UPDATE of the Boltzmann machine ([r \$0-update]): pick one of the 144 units at random \, compute its net input h \, switch it on with probability 1 / (1 + exp(-h / T)). A [t b b ...] fires from right to left., f 165;
#X obj 420 90 t b b b b b;
#X obj 420 64 r \$0-update;
#X text 560 90 <- steps 1) to 5) \, right outlet first, f 30;
#X text 20 140 1) PICK a unit: pitch p (row) and position k (column) \, and the positions before and after (the row is a cycle)., f 52;
#X obj 420 140 t b b b;
#X obj 560 166 expr uu_\$0 = random(0 \, 144);
#X obj 500 196 expr pp_\$0 = int(uu_\$0 / 12) \; kk_\$0 = uu_\$0 % 12;
#X obj 420 226 expr km_\$0 = (kk_\$0 + 11) % 12 \; kp_\$0 = (kk_\$0 + 1) % 12;
#X text 20 280 2) NET INPUT h = 2A - 2A * (others on in my row + others on in my column) - D * (cost to the pitches on just before and just after me). It equals E(me off) - E(me on): how much switching me on lowers the energy., f 52;
#X obj 420 280 expr hh_\$0 = 2 * aa_\$0 - 2 * aa_\$0 * (rc\$0[pp_\$0] - x\$0[uu_\$0] + cc\$0[kk_\$0] - x\$0[uu_\$0]) - dd_\$0 * (cpq\$0[12 * pp_\$0 + 0] * (x\$0[0 + km_\$0] + x\$0[0 + kp_\$0]) + cpq\$0[12 * pp_\$0 + 1] * (x\$0[12 + km_\$0] + x\$0[12 + kp_\$0]) + cpq\$0[12 * pp_\$0 + 2] * (x\$0[24 + km_\$0] + x\$0[24 + kp_\$0]) + cpq\$0[12 * pp_\$0 + 3] * (x\$0[36 + km_\$0] + x\$0[36 + kp_\$0]) + cpq\$0[12 * pp_\$0 + 4] * (x\$0[48 + km_\$0] + x\$0[48 + kp_\$0]) + cpq\$0[12 * pp_\$0 + 5] * (x\$0[60 + km_\$0] + x\$0[60 + kp_\$0]) + cpq\$0[12 * pp_\$0 + 6] * (x\$0[72 + km_\$0] + x\$0[72 + kp_\$0]) + cpq\$0[12 * pp_\$0 + 7] * (x\$0[84 + km_\$0] + x\$0[84 + kp_\$0]) + cpq\$0[12 * pp_\$0 + 8] * (x\$0[96 + km_\$0] + x\$0[96 + kp_\$0]) + cpq\$0[12 * pp_\$0 + 9] * (x\$0[108 + km_\$0] + x\$0[108 + kp_\$0]) + cpq\$0[12 * pp_\$0 + 10] * (x\$0[120 + km_\$0] + x\$0[120 + kp_\$0]) + cpq\$0[12 * pp_\$0 + 11] * (x\$0[132 + km_\$0] + x\$0[132 + kp_\$0])), f 90;
#X text 20 470 3) DECIDE: on with probability pr = 1 / (1 + exp(-h / T)). T near 0: on exactly when h > 0 (a Hopfield network). T large: a coin toss (noise)., f 52;
#X obj 420 470 t b b;
#X obj 480 496 expr pr_\$0 = 1 / (1 + exp(-hh_\$0 / tt_\$0));
#X obj 420 526 expr nw_\$0 = float(random(0 \, 1000000)) / 1000000 < pr_\$0;
#X text 20 580 4) APPLY: keep the row and column counts up to date., f 52;
#X obj 420 580 t b b;
#X obj 480 606 expr dl_\$0 = nw_\$0 - x\$0[uu_\$0];
#X obj 420 636 expr rc\$0[pp_\$0] = rc\$0[pp_\$0] + dl_\$0 \; cc\$0[kk_\$0] = cc\$0[kk_\$0] + dl_\$0 \; x\$0[uu_\$0] = nw_\$0, f 60;
#X text 20 720 5) PRINT (l19-trace 1): unit \, h \, pr \, new state \, T., f 52;
#X obj 420 720 expr uu_\$0 \; hh_\$0 \; pr_\$0 \; nw_\$0 \; tt_\$0;
