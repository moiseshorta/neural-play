#X obj 20 411 v ep_\$0;
#X text 140 411 phrases played, f 60;
#X obj 20 438 v nw_\$0;
#X text 140 438 2 = rest \, 1 = start a phrase \, 0 = in a phrase, f 60;
#X obj 20 465 v goal_\$0;
#X text 140 465 the goal note, f 60;
#X obj 20 492 v tg_\$0;
#X text 140 492 practice: stop at this phrase, f 60;
#X obj 20 519 v eps_\$0;
#X text 140 519 epsilon (exploration), f 60;
#X obj 20 546 v al_\$0;
#X text 140 546 alpha (learning rate), f 60;
#X obj 20 573 v ga_\$0;
#X text 140 573 gamma (discount), f 60;
