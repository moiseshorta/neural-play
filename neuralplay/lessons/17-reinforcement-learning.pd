#X obj 20 70 r \$0-move;
#X obj 20 96 expr nw_\$0;
#X obj 20 122 sel 2 1;
#X text 110 96 <- 2: rest after a cadence \, 1: start a phrase \, otherwise make a move, f 42;
#X obj 20 160 expr nw_\$0 = 1;
#X text 20 186 REST: one silent tick, f 12;
#X obj 160 160 t b b;
#X obj 220 186 expr s_\$0 = (goal_\$0 + 1 + random(0 \, 7)) % 8 \; n_\$0 = 0 \; nw_\$0 = 0, f 44;
#X text 220 250 START: a random note that is not the goal, f 44;
#X obj 160 290 expr s_\$0 \; 3;
#X obj 160 330 pack f f;
#X obj 160 366 spigot 1;
#X obj 230 340 r \$0-loud;
#X obj 160 392 s \$0-play;
#X text 250 392 <- "note kind" to the voices: kind 0 best move \, 1 random move \, 2 goal \, 3 start, f 44;
#X obj 460 122 t b b b b b b;
#X text 580 122 <- A MOVE: steps 1) to 6) \, right outlet first, f 30;
#X text 20 450 1) THE DICE: explore (a random move) with probability epsilon. o = where the search for the best move starts \, so that equal values are picked at random. m = the best value on this note., f 56;
#X obj 460 450 expr ex_\$0 = random(0 \, 1000000) < eps_\$0 * 1000000 \; o_\$0 = random(0 \, 4) \; ra_\$0 = random(0 \, 4) \; m_\$0 = max(max(q\$0[4 * s_\$0] \, q\$0[4 * s_\$0 + 1]) \, max(q\$0[4 * s_\$0 + 2] \, q\$0[4 * s_\$0 + 3])), f 100;
#X text 20 536 2) CHOOSE: the random move - or \, counting from o \, the first move whose value is the best (exploit)., f 56;
#X obj 460 536 expr a_\$0 = if(ex_\$0 \, ra_\$0 \, if(q\$0[4 * s_\$0 + o_\$0] == m_\$0 \, o_\$0 \, if(q\$0[4 * s_\$0 + (o_\$0 + 1) % 4] == m_\$0 \, (o_\$0 + 1) % 4 \, if(q\$0[4 * s_\$0 + (o_\$0 + 2) % 4] == m_\$0 \, (o_\$0 + 2) % 4 \, (o_\$0 + 3) % 4)))), f 100;
#X text 20 622 3) THE WORLD answers with the next note: move a - 2 + (a >= 2) = -2 -1 +1 +2 \, kept inside the scale., f 56;
#X obj 460 622 expr s2_\$0 = min(max(s_\$0 + a_\$0 - 2 + (a_\$0 >= 2) \, 0) \, 7), f 100;
#X text 20 708 4) THE REWARD: 1 for landing on the goal \, and the phrase is done (dn) \, otherwise nothing (0). n counts the moves of the phrase., f 56;
#X obj 460 708 expr r_\$0 = s2_\$0 == goal_\$0 \; dn_\$0 = s2_\$0 == goal_\$0 \; n_\$0 = n_\$0 + 1, f 100;
#X text 20 794 5) Q-LEARNING: first the SURPRISE dl = r + gamma * maxQ(next note) - Q(s \, a) \, with no future after the goal. Then move Q(s \, a) by alpha times the surprise - the learning rule of lesson 4 with a target the network makes itself., f 56;
#X obj 460 794 t b b;
#X obj 520 824 expr dl_\$0 = r_\$0 + (1 - dn_\$0) * ga_\$0 * max(max(q\$0[4 * s2_\$0] \, q\$0[4 * s2_\$0 + 1]) \, max(q\$0[4 * s2_\$0 + 2] \, q\$0[4 * s2_\$0 + 3])) - q\$0[4 * s_\$0 + a_\$0], f 92;
#X obj 460 872 expr q\$0[4 * s_\$0 + a_\$0] = q\$0[4 * s_\$0 + a_\$0] + al_\$0 * dl_\$0, f 100;
#X text 20 944 6) TELL AND MOVE ON: print the move (l17-trace 1) \, redraw the note that changed \, play the new note \, remember this move (for good! and bad) \, step to the new note. After the goal \, or after 32 moves \, the phrase is over., f 56;
#X obj 460 944 t b b b b b;
#X obj 1000 984 expr s_\$0 \; a_\$0 \; ex_\$0 \; r_\$0 \; s2_\$0 \; dn_\$0 \; q\$0[4 * s_\$0 + a_\$0] \; dl_\$0, f 24;
