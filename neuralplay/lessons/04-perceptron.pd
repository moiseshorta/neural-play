#N canvas 40 60 1280 960 12;
#X declare -path ..;
#X obj 0 0 cnv 1 1280 46 empty empty 04\ \ \ The\ perceptron\ learns\ (Rosenblatt\ 1958)\ \ -\ \ and\ fails\ at\ XOR\ (1969) 14 23 0 20 #1d3557 #ffffff 0;
#X obj 1110 930 declare -path ..;
#X text 800 930 finds the nn.* objects one folder up ->, f 42;
#X text 20 930 neuralplay - Moisés Horta Valenzuela / SEMILLA.AI Studio, f 70;
#X text 20 56 Lesson 1 had no learning: you chose the weights. A PERCEPTRON finds them itself \, from examples. Pick a logic gate \, press train \, and watch (and hear) the line move until every example is on the right side. Then try XOR., f 175;
#X obj 10 96 cnv 1 390 560 empty empty THE\ IDEA 8 12 0 13 #eef1f5 #1d3557 0;
#X text 20 122 Frank Rosenblatt's Mark I Perceptron (Cornell \, 1958) learned to recognise shapes from 400 light sensors. Its weights were real potentiometers turned by electric motors: a neural network made of knobs., f 52;
#X text 20 203 THE LEARNING RULE. Show one example \, compare the answer y with the target t \, nudge every weight in the direction that would have helped:, f 52;
#X text 30 254 w1 = w1 + rate * (t - y) * x1, f 52;
#X text 30 275 w2 = w2 + rate * (t - y) * x2, f 52;
#X text 30 296 b = b + rate * (t - y), f 52;
#X text 20 317 Right answer (t - y = 0): nothing changes. Rosenblatt proved that if ANY straight line separates the two classes \, this rule will find one., f 52;
#X text 20 368 1969: Minsky and Papert's book "Perceptrons" proved that one layer can never learn XOR: no straight line separates its black corners from its white ones. Funding dried up - the first "AI winter". Lesson 5 shows the way out., f 52;
#X obj 410 96 cnv 1 430 560 empty empty THE\ PICTURE 8 12 0 13 #e3f0fb #1d3557 0;
#X obj 430 126 nn.plot2d;
#X obj 430 384 unpack f f;
#X obj 430 410 expr w1_\$0*\$f1 + w2_\$0*\$f2 + b_\$0 > 0, f 44;
#X text 430 436 the callback: the neuron answers for every cell, f 52;
