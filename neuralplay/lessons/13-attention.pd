#N canvas 40 60 800 300 move-query-dot 0;
#X text 20 10 Moves the orange query dot: 96 pixels per unit \, the centre of the pad is (0 \, 0)., f 100;
#X obj 20 60 r \$0-qx;
#X obj 160 60 r \$0-qy;
#X obj 20 86 t b f;
#X obj 160 86 t b f;
#X obj 60 112 v mqx_\$0;
#X obj 200 112 v mqy_\$0;
#X obj 20 150 expr 590 + mqx_\$0 * 96 - 5 \; 270 - mqy_\$0 * 96 - 5;
#X obj 20 180 pack f f;
#X msg 20 206 pos \$1 \$2;
#X obj 20 232 s \$0-q;
