#X obj 430 800 expr sc\$0[0] = -qx_\$0 + qy_\$0 \; sc\$0[1] = qx_\$0 + qy_\$0 \; sc\$0[2] = -qx_\$0 - qy_\$0 \; sc\$0[3] = qx_\$0 - qy_\$0, f 60;
#X text 870 800 <- 1) scores: dot product of the query with each corner (-1 1) (1 1) (-1 -1) (1 -1), f 34;
#X obj 430 880 nn.softmax sc\$0 pr\$0;
#X text 600 880 <- 2) softmax with temperature T (right inlet), f 30;
#X obj 430 910 array define sc\$0 4;
#X obj 430 940 expr pr\$0[0] \; pr\$0[1] \; pr\$0[2] \; pr\$0[3] \; sc\$0[0] \; sc\$0[1] \; sc\$0[2] \; sc\$0[3];
