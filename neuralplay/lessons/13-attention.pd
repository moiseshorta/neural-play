#N canvas 40 60 1280 1010 12;
#X declare -path ..;
#X obj 0 0 cnv 1 1280 46 empty empty 13\ \ \ Attention\ \ -\ \ a\ soft\ lookup\ with\ a\ temperature\ (2014\ /\ 2017) 14 23 0 20 #1d3557 #ffffff 0;
#X obj 1110 980 declare -path ..;
#X text 800 980 finds the nn.* objects one folder up ->, f 42;
#X text 20 980 neuralplay - Moisés Horta Valenzuela / SEMILLA.AI Studio, f 70;
#X text 20 56 ATTENTION is the core of the transformer \, the architecture behind today's language and music models. It is a SOFT LOOKUP: compare a query with every key \, turn the scores into weights with softmax \, and mix the values with those weights. Here the values are four sounds and you steer the query., f 175;
#X obj 10 96 cnv 1 390 890 empty empty THE\ IDEA 8 12 0 13 #eef1f5 #1d3557 0;
#X text 20 122 A normal lookup (a dictionary) returns exactly one value: the one whose key matches. Attention returns a MIX of all values \, weighted by how well each key matches the query., f 52;
#X text 20 188 1) score_i = query . key_i (a dot product: large when they point the same way), f 52;
#X text 20 224 2) weight_i = softmax(score / T): exp(score_i / T) / sum of exp(score_j / T), f 52;
#X text 20 260 3) output = sum of weight_i * value_i, f 52;
#X text 20 281 TEMPERATURE T: small = winner takes all (a hard switch between the corners) \, large = everything blends. The "temperature" setting of chat models is this same T \, used when they pick the next word., f 52;
#X text 20 362 In a TRANSFORMER (Vaswani et al. \, 2017 \, "Attention is all you need") every word - or note \, or audio frame - makes a query \, a key and a value with learned weights \, and attends to every other one. Many heads \, many layers. Bahdanau et al. (2014) introduced attention for translation. Music Transformer (2018) and MusicGen (2023) use it for music., f 52;
#X text 20 488 HERE: the query is the point you drag. The four keys sit at the corners. Scores are dot products divided by the temperature \, exactly as above (a transformer also divides by the square root of the vector size)., f 52;
#X obj 410 96 cnv 1 430 520 empty empty THE\ QUERY\ \ (drag\ it\,\ or\ let\ it\ circle) 8 12 0 13 #e3f0fb #1d3557 0;
#X obj 470 150 cnv 1 240 240 empty empty empty 4 10 0 12 #ffffff #000000 0;
#X obj 590 150 cnv 1 1 240 empty empty empty 4 10 0 12 #d0d0d0 #000000 0;
#X obj 470 270 cnv 1 240 1 empty empty empty 4 10 0 12 #d0d0d0 #000000 0;
#X obj 488 168 cnv 1 12 12 empty empty chord 14 6 0 11 #1d3557 #1d3557 0;
#X obj 680 168 cnv 1 12 12 empty empty saw 14 6 0 11 #1d3557 #1d3557 0;
#X obj 488 360 cnv 1 12 12 empty empty wind 14 6 0 11 #1d3557 #1d3557 0;
#X obj 680 360 cnv 1 12 12 empty empty bell 14 6 0 11 #1d3557 #1d3557 0;
#X obj 585 265 cnv 1 10 10 empty \$0-q empty 4 10 0 12 #f08c00 #000000 0;
#X obj 440 150 vsl 17 240 -1.25 1.25 0 1 \$0-qy l13-qy query_y 0 -9 0 12 #fcfcfc #000000 #000000 14800 1;
#X obj 470 400 hsl 240 17 -1.25 1.25 0 1 \$0-qx l13-qx query_x 244 8 0 12 #fcfcfc #000000 #000000 8100 1;
#X obj 430 450 hsl 180 15 0.03 5 1 1 \$0-temp l13-temp temperature\ T 0 -8 0 11 #fcfcfc #000000 #000000 9800 1;
#X floatatom 618 449 7 0 0 0 - - - 0;
#X obj 430 490 tgl 19 0 empty l13-circle let\ the\ query\ circle\ around 24 10 0 12 #fcfcfc #000000 #000000 0 1;
#X obj 430 540 hsl 180 15 0.02 1 1 1 empty empty circle\ speed\ (turns\ per\ second) 0 -8 0 11 #fcfcfc #000000 #000000 7400 1;
#X floatatom 618 539 7 0 0 0 - - - 0;
#N canvas 40 60 900 400 circle 0;
#X text 20 10 Moves the query around a circle of radius 1 by driving the two sliders (cos and sin of a phase that grows every 30 ms)., f 110;
#X obj 20 60 inlet;
#X obj 200 60 inlet;
#X obj 20 90 metro 30;
#X obj 20 120 f;
#X obj 70 120 +;
#X obj 200 90 expr \$f1 * 6.283185 * 0.03;
#X obj 20 160 expr cos(\$f1) \; sin(\$f1);
#X obj 20 200 s l13-qx;
#X obj 160 200 s l13-qy;
#X connect 1 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 4 1;
#X connect 2 0 6 0;
#X connect 6 0 5 1;
#X connect 4 0 7 0;
#X connect 7 0 8 0;
#X connect 7 1 9 0;
#X restore 700 490 pd circle;
#X obj 850 96 cnv 1 420 520 empty empty SCORES\ AND\ WEIGHTS 8 12 0 13 #e3f0fb #1d3557 0;
#X text 870 126 scores (query . key) for chord \, saw \, wind \, bell, f 50;
#X floatatom 870 150 7 0 0 3 chord \$0-s0 - 0;
#X floatatom 965 150 7 0 0 3 saw \$0-s1 - 0;
#X floatatom 1060 150 7 0 0 3 wind \$0-s2 - 0;
#X floatatom 1155 150 7 0 0 3 bell \$0-s3 - 0;
#X text 870 200 weights = softmax(scores / T): they always add up to 1, f 50;
#X obj 870 224 cnv 1 380 140 empty empty empty 4 10 0 12 #ffffff #000000 0;
#N canvas 0 50 450 250 (subpatch) 0;
#X array pr\$0 4 float 10;
#X coords 0 1 4 0 380 140 1 0 0;
#X restore 870 224 graph;
#X text 890 368 chord, f 8;
#X floatatom 870 392 7 0 0 0 - \$0-g0 - 0;
#X text 985 368 saw, f 8;
#X floatatom 965 392 7 0 0 0 - \$0-g1 - 0;
#X text 1080 368 wind, f 8;
#X floatatom 1060 392 7 0 0 0 - \$0-g2 - 0;
#X text 1175 368 bell, f 8;
#X floatatom 1155 392 7 0 0 0 - \$0-g3 - 0;
#X text 870 430 Small T: one bar near 1 \, the rest near 0 - a switch. Large T: four similar bars - a blend. Watch the bars while the query circles \, at T = 2 and at T = 0.05., f 50;
#X obj 410 626 cnv 1 860 360 empty empty THE\ COMPUTATION\ \ (runs\ whenever\ the\ query\ or\ T\ changes) 8 12 0 13 #e3f0fb #1d3557 0;
