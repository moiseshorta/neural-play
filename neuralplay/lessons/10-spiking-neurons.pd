#X obj 630 320 expr 1000 / (\$f1 * sr_\$0);
#X obj 430 350 fexpr~ if(\$y1 >= 1 \, 0 \, \$y1 + (\$x1 - \$y1) * \$f2) \; \$y1 >= 1, f 40;
#X text 730 350 <- the LIF neuron. \$y1 = v one sample ago \, \$f2 = dt / tau, f 18;
#X obj 430 430 expr if(\$f1 > 1 \, 1000 / (\$f2 * log(\$f1 / (\$f1 - 1))) \, 0);
