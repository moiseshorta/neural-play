#N canvas 40 60 1280 1400 12;
#X declare -path ..;
#X obj 0 0 cnv 1 1280 46 empty empty 06\ \ \ Backpropagation\ \ -\ \ the\ network\ learns\ XOR\ by\ itself\ (1986) 14 23 0 20 #1d3557 #ffffff 0;
#X obj 1110 1370 declare -path ..;
#X text 800 1370 finds the nn.* objects one folder up ->, f 42;
#X text 20 1370 neuralplay - Moisés Horta Valenzuela / SEMILLA.AI Studio, f 70;
#X text 20 56 Lesson 5 solved XOR with hand-picked weights. Here a network with 3 hidden neurons starts from RANDOM weights and finds them itself: after every example it measures its error and passes the blame backwards \, layer by layer. Listen to its four answers turn into the rhythm 0 1 1 0 while the hiss of the error fades away., f 175;
#X obj 10 96 cnv 1 390 620 empty empty THE\ IDEA:\ walking\ downhill 8 12 0 13 #eef1f5 #1d3557 0;
#X text 20 122 LOSS = how wrong the network is: L = (y - t)^2 / 2 for one example., f 52;
#X text 20 158 GRADIENT DESCENT: move every weight a little against the slope of the loss: w = w - rate * dL/dw. Like walking downhill in fog - you only feel the slope under your feet., f 52;
#X text 20 224 BACKPROPAGATION finds every slope with the chain rule \, from the output back to the input:, f 52;
#X text 30 260 dy = (y - t) * y * (1 - y), f 52;
#X text 30 281 dh_k = dy * v_k * (1 - h_k^2), f 52;
#X text 20 302 dy is the output error times the slope of the sigmoid. dh_k is the share of the blame of hidden neuron k (through its weight v_k) times the slope of tanh. Then every weight moves by rate * (error at its end) * (signal at its start)., f 52;
#X text 20 398 It is the perceptron rule of lesson 4 - but now the error reaches the hidden layer. Linnainmaa 1970 \, Werbos 1974 \, made famous by Rumelhart \, Hinton and Williams (1986). Every modern network \, transformers included \, learns like this., f 52;
#X text 20 479 TRY: train XOR \, then AND \, OR \, XNOR. Push the learning rate to 5: the loss jumps around (steps too big). Try other seeds: some learn fast \, some get stuck in a valley that is not the deepest one (a local minimum) - press "new start"., f 52;
#X obj 410 96 cnv 1 430 620 empty empty THE\ NETWORK\ RIGHT\ NOW 8 12 0 13 #e3f0fb #1d3557 0;
#X obj 430 126 nn.plot2d;
#X obj 430 384 unpack f f;
#X obj 430 410 expr 1/(1 + exp(-(v1_\$0*tanh(wa1_\$0*\$f1 + wb1_\$0*\$f2 + hb1_\$0) + v2_\$0*tanh(wa2_\$0*\$f1 + wb2_\$0*\$f2 + hb2_\$0) + v3_\$0*tanh(wa3_\$0*\$f1 + wb3_\$0*\$f2 + hb3_\$0) + c_\$0))), f 44;
#X text 430 484 callback: the whole network as one formula, f 52;
