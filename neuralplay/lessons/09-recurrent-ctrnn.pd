#N canvas 40 60 1280 1000 12;
#X declare -path ..;
#X obj 0 0 cnv 1 1280 46 empty empty 09\ \ \ Recurrent\ neurons\ \ -\ \ a\ CTRNN\ oscillator\ from\ LFO\ to\ audio\ (Beer\ 1995) 14 23 0 20 #1d3557 #ffffff 0;
#X obj 1110 970 declare -path ..;
#X text 800 970 finds the nn.* objects one folder up ->, f 42;
#X text 20 970 neuralplay - Moisés Horta Valenzuela / SEMILLA.AI Studio, f 70;
#X text 20 56 Feed neurons their own output and they get MEMORY - and can oscillate. Two leaky neurons \, one exciting the other and being inhibited back \, make a self-sustained oscillator. Its speed is set by the time constant tau: from slow LFO sweeps (tau = 1 s) up into audible pitch (tau = 0.1 ms)., f 175;
#X obj 10 96 cnv 1 390 600 empty empty THE\ IDEA 8 12 0 13 #eef1f5 #1d3557 0;
#X text 20 122 A CONTINUOUS-TIME RECURRENT NEURON (CTRNN) does not jump to its new value: it slides there. Its weighted sum goes through a leaky integrator - a one-pole lowpass - before the curve:, f 52;
#X text 30 188 tau * dy/dt = -y + sum of w * o + bias, f 52;
#X text 30 209 o = sigmoid(y), f 52;
#X text 20 230 In [nn.neuron~] this is the message "tau <ms>": a [lop~] at 1 / (2 pi tau) Hz., f 52;
#X text 20 266 Randall Beer (1995) used tiny CTRNNs as the "nervous systems" of simulated walking insects: central pattern generators \, the rhythm circuits real animals use to walk \, swim and breathe., f 52;
#X text 20 332 THE OSCILLATOR (Beer's classic weights): each neuron excites itself strongly (4.5) \, the left one excites the right one (+1) \, the right one inhibits the left one (-1). One chases the other forever: a limit cycle., f 52;
#X text 20 413 MUSIC: the same circuit is an LFO at tau = 100 ms and a tone generator at tau = 0.1 ms. Forcing it with another oscillator produces locking \, beating and chaos., f 52;
#X obj 410 96 cnv 1 860 340 empty empty THE\ CIRCUIT 8 12 0 13 #e3f0fb #1d3557 0;
#N canvas 40 60 1000 520 ctrnn-2-neurons 0;
#X obj 10 10 nn.neuron~ sigmoid l09a;
#X obj 170 10 nn.neuron~ sigmoid l09b;
#X text 20 110 TWO LEAKY NEURONS IN A LOOP. [block~ 1] makes this subpatch compute ONE SAMPLE at a time \, so the feedback through [s~]/[r~] is delayed by only 1 sample (in a normal patch it would be 64 samples - a delay that would add an oscillation of its own). Each neuron hears itself (inlet 1 = o1 \, inlet 2 = o2) and the left one also the external force (inlet 3)., f 130;
#X obj 20 200 block~ 1;
#X obj 20 240 r~ \$0-o1;
#X obj 120 240 r~ \$0-o2;
#X obj 240 240 inlet~;
#X text 300 240 <- external force, f 20;
#X obj 20 300 s~ \$0-o1;
#X obj 170 300 s~ \$0-o2;
#X obj 20 340 outlet~;
#X obj 170 340 outlet~;
#X text 20 370 outlets: o1 o2 (both 0..1 \, sigmoid), f 40;
#X connect 4 0 0 0;
#X connect 5 0 0 1;
#X connect 6 0 0 2;
#X connect 4 0 1 0;
#X connect 5 0 1 1;
#X connect 0 0 8 0;
#X connect 1 0 9 0;
#X connect 0 0 10 0;
#X connect 1 0 11 0;
#X coords 0 -1 1 1 330 80 2 5 5;
#X restore 430 130 pd ctrnn-2-neurons;
#X text 780 130 <- the two neurons (open the box: [block~ 1] \, 1-sample feedback), f 40;
#X msg 430 236 \; nn-l09a w 4.5 1 1 \; nn-l09a bias -2.75 \; nn-l09b w -1 4.5 0 \; nn-l09b bias -1.75;
#X obj 780 180 loadbang;
#X msg 660 236 \; nn-l09a w 1 0.5 1 \; nn-l09b w -0.5 1 0;
#X msg 880 236 \; nn-l09a spread 5 \; nn-l09a randomize \; nn-l09b spread 5 \; nn-l09b randomize;
#X text 430 330 Beer oscillator weights (sent at load: click to restore), f 30;
#X text 660 330 weak self-excitation: no oscillation \, it settles, f 30;
#X text 880 330 random weights (sometimes it oscillates), f 30;
#X obj 410 446 cnv 1 860 250 empty empty TIME\ +\ FORCE 8 12 0 13 #e3f0fb #1d3557 0;
#X obj 430 490 hsl 200 15 0.03 1000 1 1 empty l09-tau tau\ (ms):\ the\ speed\ of\ both\ neurons 0 -8 0 11 #fcfcfc #000000 #000000 14200 1;
#X floatatom 638 489 7 0 0 0 - - - 0;
#X obj 430 540 hsl 200 15 0.25 4 1 1 empty l09-ratio tau\ ratio:\ right\ neuron\ =\ tau\ *\ ratio 0 -8 0 11 #fcfcfc #000000 #000000 10000 1;
#X floatatom 638 539 7 0 0 0 - - - 0;
#X obj 720 490 pack f f;
#X obj 720 540 t b f;
#X obj 720 516 expr \$f1 \; \$f1 * \$f2;
#X msg 900 490 \; nn-l09a tau \$1;
#X msg 1020 490 \; nn-l09b tau \$1;
#X obj 430 600 hsl 200 15 0.1 1000 1 1 empty empty force:\ frequency\ (Hz) 0 -8 0 11 #fcfcfc #000000 #000000 8500 1;
#X floatatom 638 599 7 0 0 0 - - - 0;
#X obj 430 640 hsl 200 15 0 3 0 1 empty l09-force force:\ amount 0 -8 0 11 #fcfcfc #000000 #000000 0 1;
#X floatatom 638 639 7 0 0 0 - - - 0;
#X obj 720 600 osc~;
#X obj 720 640 *~;
#X text 800 620 <- push the left neuron with a sine: listen for locking (it follows the force) and chaos, f 40;
#X obj 10 706 cnv 1 1260 280 empty empty LOOK\ +\ LISTEN 8 12 0 13 #fff1e0 #1d3557 0;
#X obj 30 740 cnv 1 240 100 empty empty empty 4 10 0 12 #ffffff #000000 0;
#N canvas 0 50 450 250 (subpatch) 0;
