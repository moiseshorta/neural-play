#X obj 300 336 expr cur\$0[\$f1] = pp\$0[20 * pl_\$0 + \$f1];
#X obj 20 420 fexpr~ \$y1[-1] + kk_\$0 * (0 - \$y1[-1] + cur\$0[0] * tanh(\$y1[-1]) + cur\$0[1] * tanh(\$y2[-1]) + cur\$0[2] * tanh(\$y3[-1]) + cur\$0[3] * tanh(\$y4[-1]) + cur\$0[4]) \; \$y2[-1] + kk_\$0 * (0 - \$y2[-1] + cur\$0[5] * tanh(\$y1[-1]) + cur\$0[6] * tanh(\$y2[-1]) + cur\$0[7] * tanh(\$y3[-1]) + cur\$0[8] * tanh(\$y4[-1]) + cur\$0[9]) \; \$y3[-1] + kk_\$0 * (0 - \$y3[-1] + cur\$0[10] * tanh(\$y1[-1]) + cur\$0[11] * tanh(\$y2[-1]) + cur\$0[12] * tanh(\$y3[-1]) + cur\$0[13] * tanh(\$y4[-1]) + cur\$0[14]) \; \$y4[-1] + kk_\$0 * (0 - \$y4[-1] + cur\$0[15] * tanh(\$y1[-1]) + cur\$0[16] * tanh(\$y2[-1]) + cur\$0[17] * tanh(\$y3[-1]) + cur\$0[18] * tanh(\$y4[-1]) + cur\$0[19]), f 110;
